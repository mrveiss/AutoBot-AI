#!/usr/bin/env bash
# AutoBot - AI-Powered Automation Platform
# Copyright (c) 2025 mrveiss
# Author: mrveiss
#
# pre-push: enforce Phase 0c (verify before push + no duplicate PR for
# already-merged issue) from the batch-implement skill.
#
# Issues #5142 (verification mandate) and #5143 (pre-push duplicate check).
#
# Bypass with `git push --no-verify` if you absolutely must (don't).

set -uo pipefail  # NOT -e: we want to capture exit codes and report

# #17035: git runs every hook from the top of the working tree (githooks(5)),
# so $PWD is this checkout's root. The bare `git rev-parse --show-toplevel`
# that stood here is the #15783 class, and this hook is the worst place for
# it: the pre-push environment carries GIT_DIR pointing at the pushing
# worktree's git dir, which outranks the working directory and answers for a
# different checkout. That is why scripts/install-git-hooks.sh already has to
# `unset GIT_DIR` (#15246). Same resolution as the commit-msg hook (#17032).
REPO_ROOT="$PWD"

# Time-box each check. Frontend type-check on the whole project takes ~60s;
# we'd rather warn than block forever.
TYPE_CHECK_TIMEOUT=90
TEST_TIMEOUT=120

# Color helpers (no-op when not a tty)
if [ -t 1 ]; then
  RED='\033[0;31m'; YEL='\033[0;33m'; GRN='\033[0;32m'; BLU='\033[0;34m'; CLR='\033[0m'
else
  RED=''; YEL=''; GRN=''; BLU=''; CLR=''
fi

log()   { printf "${BLU}[pre-push]${CLR} %s\n" "$*" >&2; }
warn()  { printf "${YEL}[pre-push WARN]${CLR} %s\n" "$*" >&2; }

# A timed-out check DID NOT RUN. Spelling that like a warning and exiting zero made
# the gate's coverage inversely proportional to the risk of the push: a two-file
# change was verified and a 162-file change was not, and `WARN ... skipping` reads
# as a note rather than as "this was never tested" (#15985).
#
# So a timeout fails the push. The opt-out names itself in the output, because an
# escape hatch nobody can see in the transcript is indistinguishable from the bug.
ALLOW_TIMEOUT="${AUTOBOT_PREPUSH_ALLOW_TIMEOUT:-0}"
ALLOW_UNRUNNABLE="${AUTOBOT_PREPUSH_ALLOW_UNRUNNABLE:-0}"
did_not_run() {
    # $1 = tool, $2 = seconds
    if [ "$ALLOW_TIMEOUT" = "1" ]; then
        warn "$1 DID NOT RUN (timed out after ${2}s) — allowed by AUTOBOT_PREPUSH_ALLOW_TIMEOUT=1"
        return 0
    fi
    printf "${RED}[pre-push DID NOT RUN]${CLR} %s timed out after %ss — this push is NOT verified.\n" "$1" "$2" >&2
    printf "${RED}[pre-push DID NOT RUN]${CLR} Run it yourself, or re-push with AUTOBOT_PREPUSH_ALLOW_TIMEOUT=1 to accept an unverified push.\n" >&2
    EXIT_CODE=1
}
could_not_run() {
    # $1 = tool, $2 = the reason, quoted from the tool's own output.
    #
    # NOT the same as a failure, and not the same as a pass (#16711 follow-on).
    # A check that cannot execute on this interpreter found nothing because it
    # did not look -- MEASUREMENT_DISCIPLINE's distinction, applied to the gate
    # itself. Reporting it as a failure is what taught people to reach for
    # `git push --no-verify`, which switches off all 50-odd OTHER checks to get
    # past one that was never going to run. This escape switches off exactly
    # the one, names it, and leaves every other check blocking.
    if [ "$ALLOW_UNRUNNABLE" = "1" ]; then
        warn "$1 COULD NOT RUN on this interpreter — allowed by AUTOBOT_PREPUSH_ALLOW_UNRUNNABLE=1"
        warn "  reason: $2"
        warn "  this push is NOT verified by $1 locally; CI runs it on the supported interpreter"
        return 0
    fi
    printf "${RED}[pre-push COULD NOT RUN]${CLR} %s cannot execute here — this push is NOT verified.\n" "$1" >&2
    printf "${RED}[pre-push COULD NOT RUN]${CLR}   reason: %s\n" "$2" >&2
    printf "${RED}[pre-push COULD NOT RUN]${CLR} Run it on the supported interpreter, or re-push with\n" >&2
    printf "${RED}[pre-push COULD NOT RUN]${CLR} AUTOBOT_PREPUSH_ALLOW_UNRUNNABLE=1 to accept an unverified push.\n" >&2
    printf "${RED}[pre-push COULD NOT RUN]${CLR} Do NOT use --no-verify for this: it also skips the checks that DO work.\n" >&2
    EXIT_CODE=1
}
fail()  { printf "${RED}[pre-push FAIL]${CLR} %s\n" "$*" >&2; }

# ---------------------------------------------------------------------------
# #18058: run pytest on an interpreter that meets the platform's 3.11 floor.
#
# Bare `python3` is whatever the machine happens to ship.  Where that is below
# 3.11, every selected group dies at COLLECT time on a 3.11-only name
# (enum.StrEnum, asyncio.Task.cancelling) and the push is blocked by the
# interpreter rather than by anything in the changeset.  Classifying that
# after the fact only names the problem; choosing a conforming interpreter
# removes it.
#
# Preference order, all derived from the session -- no absolute paths:
#   1. the repo's own venv, which is what the tree was set up against
#   2. python3, when it already meets the floor
#   3. the newest explicitly-versioned python3.N on PATH that meets it
# Falls back to python3 so the floor classifier above still reports honestly
# when nothing conforming exists.
# ---------------------------------------------------------------------------
pick_python() {
    # A candidate qualifies only if it meets the floor AND can actually
    # IMPORT pytest -- find_spec only proves the package is locatable, so a
    # stale venv with a broken install would be chosen over a working python3.
    # Version alone is not enough: a bare /usr/bin/python3.14 with no pytest
    # fails with "No module named pytest", which is the same push-blocking
    # non-failure in different words.
    local candidate main_root
    # In a worktree $PWD is the worktree, which has no venv; the venv lives in
    # the main checkout, whose path is the parent of the common git dir.
    main_root="$(dirname "$(git rev-parse --git-common-dir 2>/dev/null || echo .)")"
    for candidate in "$REPO_ROOT/venv/bin/python" "$REPO_ROOT/.venv/bin/python" \
                     "$main_root/venv/bin/python" "$main_root/.venv/bin/python" \
                     python3 python3.14 python3.13 python3.12 python3.11; do
        command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ] || continue
        if "$candidate" -c 'import sys; sys.exit(1) if sys.version_info < (3, 11) else __import__("pytest")' 2>/dev/null; then
            printf '%s' "$candidate"
            return 0
        fi
    done
    printf '%s' python3
}
PYTEST_PYTHON="$(pick_python)"


# A dependency root is usable only if it can be TRAVERSED. A directory that is
# present but carries no execute bit answers `-d` yes and denies everything
# inside it (#17573: autobot-slm-frontend/node_modules is mode 644, so every
# binary in .bin is unreachable). `-d` alone therefore reports a usable
# toolchain where there is none, which is how a check that CANNOT run comes to
# read as one that found nothing.
node_modules_usable() {
  [ -d "$1/node_modules" ] && [ -x "$1/node_modules" ]
}
ok()    { printf "${GRN}[pre-push OK]${CLR} %s\n" "$*" >&2; }

EXIT_CODE=0

# ---------------------------------------------------------------------------
# Open-PR cap (#17006): refuse a NEW-branch push once open PRs in this repo
# -- excluding forks and bot authors -- are at or above the cap. A push to a
# branch that already exists on the remote (an already-open PR) is never
# blocked here: finishing open work must always stay possible.
#
# AUTOBOT_OPEN_PR_CAP is the only knob (default 40) -- deliberately no bypass
# flag or env override that skips the check. This is a hook-only, bash-read
# var: it is not in autobot_shared/env_registry.py / ENV_VARS.md because that
# registry's pre-commit check (pipeline-scripts/check_env_var_registry.py)
# only AST-scans .py files for os.getenv("AUTOBOT_..."); the precedent for a
# bash-only AUTOBOT_* var living in a hook's own header comment instead is
# AUTOBOT_PREPUSH_ALLOW_TIMEOUT, above.
#
# Fails CLOSED (docs/developer/MEASUREMENT_DISCIPLINE.md): if gh is missing,
# unauthenticated, the query fails, or it times out, the push is refused with
# a message saying the count could not be determined -- that is NOT the same
# as "under the cap". One API call: the filtered count and the oldest 10 open
# PRs both come from a single `gh pr list --jq` invocation, time-boxed to
# OPEN_PR_CAP_TIMEOUT like the other checks in this file (TEST_TIMEOUT /
# TYPE_CHECK_TIMEOUT, #15985) -- EXCEPT that a timeout here is never covered
# by AUTOBOT_PREPUSH_ALLOW_TIMEOUT: that var is this file's escape hatch for
# an unverified push, and the cap has none (#17008 review) -- a timed-out
# count is still an undetermined count, not a pass.
#
# Bot detection: `is_bot` is what actually excludes GitHub Apps in practice.
# Measured against this repo's own dependabot history (#17008 review): gh's
# GraphQL `author.login` for a bot reports the App-slug form `app/dependabot`,
# never the REST-style `dependabot[bot]`, so the login-suffix test below is a
# defensive fallback for a shape not observed in this API, not the mechanism
# that actually does the excluding.
# ---------------------------------------------------------------------------
OPEN_PR_CAP="${AUTOBOT_OPEN_PR_CAP:-40}"
OPEN_PR_CAP_TIMEOUT=10

check_open_pr_cap() {
  if ! command -v gh >/dev/null 2>&1; then
    fail "open-PR cap: could not determine the open PR count (gh CLI not found)."
    fail "  This is NOT 'under the cap'. Install/configure gh, or push to an existing PR branch instead."
    return 1
  fi

  local out gh_exit
  out=$(timeout "$OPEN_PR_CAP_TIMEOUT" gh pr list --state open --limit 1000 \
    --json number,title,createdAt,author,isCrossRepository \
    --jq '
      ( [ .[] | select(.isCrossRepository == false)
               | select((.author.is_bot // false) == false)
               | select((.author.login // "") | test("\\[bot\\]$") | not) ] ) as $counted
      | ($counted | length | tostring),
      ( $counted | sort_by(.createdAt) | .[0:10][] | (.number|tostring) + "\t" + .title )
    ' 2>&1)
  gh_exit=$?

  if [ "$gh_exit" = "124" ]; then
    fail "open-PR cap: could not determine the open PR count (gh query timed out after ${OPEN_PR_CAP_TIMEOUT}s). This is NOT 'under the cap'."
    fail "  No override for this -- AUTOBOT_PREPUSH_ALLOW_TIMEOUT does not apply to the open-PR cap. Retry, or push to an existing PR branch instead."
    return 1
  fi

  if [ "$gh_exit" != "0" ] || [ -z "$out" ]; then
    fail "open-PR cap: could not determine the open PR count (gh query failed). This is NOT 'under the cap'."
    printf '%s\n' "$out" | head -5 >&2
    fail "  Check 'gh auth status', then re-push. Pushes to existing PR branches are never blocked."
    return 1
  fi

  local count
  count=$(printf '%s\n' "$out" | head -1)
  case "$count" in
    ''|*[!0-9]*)
      fail "open-PR cap: could not determine the open PR count (unexpected gh output). This is NOT 'under the cap'."
      printf '%s\n' "$out" | head -5 >&2
      return 1
      ;;
  esac

  if [ "$count" -ge "$OPEN_PR_CAP" ]; then
    fail "open-PR cap: $count open PR(s) >= cap of $OPEN_PR_CAP -- new-branch pushes are refused until open work is finished."
    fail "  Merge, close, or finish open PRs first. Pushes to EXISTING PR branches still work (this gate only blocks a NEW branch)."
    fail "  Oldest open PRs to act on:"
    printf '%s\n' "$out" | tail -n +2 | sed 's/^/    #/' >&2
    return 1
  fi

  ok "open-PR cap: $count/$OPEN_PR_CAP open PRs -- below cap"
  return 0
}

# ---------------------------------------------------------------------------
# Read git's stdin: <local-ref> <local-sha> <remote-ref> <remote-sha>
# Process each pushed ref. Skip deletes (sha = 0000...).
# ---------------------------------------------------------------------------
ZERO=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue  # deletion
  log "checking $local_ref → $remote_ref"

  # ------------------------------------------------------------------------
  # Open-PR cap (#17006): only for a BRANCH ref that does not yet exist on
  # the remote -- a brand-new branch. remote_sha is all-zero for exactly that
  # case in git's pre-push stdin protocol, but that alone is not sufficient:
  # a brand-new TAG (`git push origin v1.2.3`) has a zero remote_sha too, and
  # a tag is never a PR head (#17008 review). refs/heads/* is what narrows it
  # to an actual branch.
  # ------------------------------------------------------------------------
  if [ "$remote_sha" = "$ZERO" ] && [[ "$local_ref" == refs/heads/* ]]; then
    if ! check_open_pr_cap; then
      EXIT_CODE=1
      continue
    fi
  fi

  # ------------------------------------------------------------------------
  # Phase 6 (#5143): pre-push duplicate check for issue branches
  # ------------------------------------------------------------------------
  branch_name="${local_ref#refs/heads/}"
  if [[ "$branch_name" =~ ^issue-([0-9]+)(-.*)?$ ]]; then
    issue_num="${BASH_REMATCH[1]}"

    if command -v gh >/dev/null 2>&1; then
      # Issue state lookup; tolerate gh failures (not signed in, offline, etc.)
      issue_state=$(gh issue view "$issue_num" --json state --jq '.state' 2>/dev/null || echo "")
      if [ "$issue_state" = "CLOSED" ]; then
        warn "Issue #$issue_num is CLOSED on GitHub."
        warn "  Verify your work isn't superseded before pushing."
        warn "  $ gh issue view $issue_num --comments | head -50"
      fi

      # Has main already merged a commit citing this issue?
      git fetch origin main --quiet 2>/dev/null || true
      if git log origin/main --oneline -50 2>/dev/null | grep -qE "#${issue_num}\\b"; then
        warn "origin/main already has a commit citing #$issue_num:"
        git log origin/main --oneline -50 2>/dev/null \
          | grep -E "#${issue_num}\\b" \
          | head -3 \
          | sed 's/^/  /' >&2
        warn "  If that commit covers your fix, your push will create a duplicate PR."
      fi
    else
      warn "gh CLI not installed — skipping issue state check (#5143)"
    fi
  fi

  # ------------------------------------------------------------------------
  # Phase 7 (#16859): PR body must satisfy the template-sections and
  # same-scope-batching gates before CI runs, not after.
  #
  # `gh pr create --body-file` never loads .github/PULL_REQUEST_TEMPLATE.md,
  # so an author writing a body in a file learns the required headings from a
  # red check ~63 checks in, not before the push. This runs the two gates
  # locally against the PR body itself, the same functions CI calls
  # (scripts/validate_pr_body.py), so a body that passes here passes there.
  #
  # Only covers a branch that ALREADY has an open PR: a body that does not
  # exist yet (before the first `gh pr create`) cannot be read by a git hook,
  # and pretending otherwise would be worse than saying so.
  #
  # Three states, and they must not collapse into two (#16866 review):
  # `gh` absent, `gh` present but the call failed (not signed in, offline,
  # rate-limited, an API error), and `gh` present with a confirmed "this
  # branch has no PR". The middle state is NOT the same as the third — both
  # end with an empty `pr_number`, but only the third is a true claim that
  # nothing needs checking. Collapsing them told an author "no open PR yet"
  # when `gh` had in fact not run, which is the exact defect class this PR
  # argues against: a skip that reads as "nothing to check". `gh pr view`
  # exits non-zero for BOTH the real "no PR" case and every failure case, so
  # the two are told apart by matching the one message `gh` prints for a
  # genuine no-PR branch, not by exit code alone.
  # ------------------------------------------------------------------------
  if ! command -v gh >/dev/null 2>&1; then
    log "gh CLI not installed — PR body NOT checked (#16859); before pushing, validate it yourself:"
    log "  python3 scripts/validate_pr_body.py --file <path>"
  else
    gh_view_output=$(gh pr view "$branch_name" --json number --jq '.number' 2>&1)
    gh_view_exit=$?
    if [ "$gh_view_exit" = "0" ]; then
      pr_number="$gh_view_output"
      log "PR #$pr_number exists for $branch_name — checking its body (#16859)"
      body_check_output=$(python3 "$REPO_ROOT/scripts/validate_pr_body.py" --pr "$branch_name" 2>&1)
      body_check_exit=$?
      if [ "$body_check_exit" != "0" ]; then
        fail "PR body fails the template-sections and/or batching gate (#16859):"
        echo "$body_check_output" | sed 's/^/  /' >&2
        EXIT_CODE=1
      else
        ok "PR body satisfies both gates"
      fi
    elif echo "$gh_view_output" | grep -qi "no pull requests found"; then
      # #16859: stated rather than silent. A hook cannot see a body that has
      # no PR yet, so this is the limit of what pre-push can cover -- not a
      # skip that looks identical to "nothing to check".
      log "no open PR yet for $branch_name — this hook cannot check a body before 'gh pr create' (#16859)"
      log "  before 'gh pr create --body-file <path>', validate it yourself:"
      log "  python3 scripts/validate_pr_body.py --file <path>"
    else
      # gh ran and failed for a reason OTHER than "no PR" -- not signed in,
      # offline, rate-limited, an API error. Must not read as "no open PR":
      # the branch may have a PR with a broken body, and the true answer is
      # this check did not run, not that it found nothing wrong.
      warn "gh pr view failed (not the 'no PR' case) — PR body NOT checked (#16859):"
      echo "$gh_view_output" | sed 's/^/  /' >&2
    fi
  fi

  # ------------------------------------------------------------------------
  # Phase 0c (#5142): verification mandate (type-check + test-run)
  # ------------------------------------------------------------------------
  # Find files changed in the commits we're pushing. Always prefer the merge
  # base with origin/main (or release): this is the PR's own diff regardless
  # of whether the remote already has a prior push. A raw ${remote_sha}..
  # ${local_sha} two-dot range -- correct only for a first push, where
  # remote_sha is 0000... -- silently included every file that changed on
  # origin/main between the branch's last push and now once used after a
  # `git rebase origin/main` + force-push, inflating the verified changeset
  # with unrelated files (#16637).
  base=$(git merge-base "$local_sha" origin/main 2>/dev/null \
      || git merge-base "$local_sha" release 2>/dev/null \
      || echo "")
  if [ -n "$base" ]; then
    diff_range="${base}..${local_sha}"
  elif [ "$remote_sha" = "$ZERO" ]; then
    warn "Cannot determine merge base — skipping Phase 0c verification"
    continue
  else
    # Last-resort fallback, only when no merge base could be found at all
    # (e.g. a shallow clone): the old two-dot range beats skipping Phase 0c
    # outright on an ordinary push.
    diff_range="${remote_sha}..${local_sha}"
  fi

  changed=$(git diff --name-only "$diff_range" 2>/dev/null || echo "")

  # Scale the budget with the changeset (#15985). A fixed 120s made the gate's
  # coverage inversely proportional to the risk of the push: small changes finished
  # and large ones timed out, so the pushes most worth verifying went unverified.
  changed_count=$(printf '%s\n' "$changed" | grep -c . || true)
  TEST_TIMEOUT=$(( TEST_TIMEOUT + (changed_count * 4) ))
  [ "$TEST_TIMEOUT" -gt 600 ] && TEST_TIMEOUT=600
  TYPE_CHECK_TIMEOUT=$(( TYPE_CHECK_TIMEOUT + (changed_count * 3) ))
  [ "$TYPE_CHECK_TIMEOUT" -gt 450 ] && TYPE_CHECK_TIMEOUT=450
  log "changeset ${changed_count} file(s) -> pytest/vitest budget ${TEST_TIMEOUT}s, vue-tsc ${TYPE_CHECK_TIMEOUT}s"
  if [ -z "$changed" ]; then
    log "no changed files in range — skipping Phase 0c"
    continue
  fi

  # ----- Frontend (TypeScript / Vue) --------------------------------------
  #
  # PER PROJECT (#17574). This phase named `autobot-frontend` as a literal while
  # being reached by ANY changed `.ts`/`.vue`, so a change in another tree --
  # autobot-slm-frontend, libs/autobot-ui, libs/autobot-sdk-ts, the MCP tools --
  # type-checked autobot-frontend instead: a pass that says nothing about the
  # change, and a failure attributed to the wrong files (the triage below strips
  # only its own prefix, so a foreign path can never match a diagnostic and a
  # real error in it is classified "pre-existing").
  #
  # Worse on the test side: the selection stripped only `autobot-frontend/`, so a
  # foreign test path survived intact and was handed to a vitest rooted in
  # autobot-frontend, whose config includes `src/**` only. The filter matched
  # nothing, vitest exited non-zero, and this hook reported `vitest failures` for
  # tests that had never run -- a red naming specific files, which costs more than
  # a silent green because someone goes and debugs tests that are fine. #16912's
  # `could_not_run` branch could not catch it either: it is guarded on
  # node_modules being ABSENT, and autobot-frontend's is present.
  #
  # #16069 made exactly this split for pytest -- two trees, two dependency roots,
  # one invocation each. This is the frontend half.
  #
  # Each project's own `type-check` script is invoked rather than a tsconfig named
  # here: autobot-frontend uses tsconfig.app.json, autobot-slm-frontend uses
  # tsconfig.json, and a table of those in this file is a second declaration that
  # drifts from package.json. FRONTEND_PROJECTS is the two trees that declare
  # that script; repo_tests/prepush_frontend_projects_17574_test.py fails if a
  # third appears, so a new frontend cannot silently fall into the first one.
  FRONTEND_PROJECTS="autobot-frontend autobot-slm-frontend"

  frontend_changed=$(echo "$changed" | grep -E '\.(ts|vue)$' || true)
  frontend_unclaimed="$frontend_changed"

  for project in $FRONTEND_PROJECTS; do
    project_changed=$(echo "$frontend_changed" | grep -E "^${project}/" || true)
    [ -n "$project_changed" ] || continue
    frontend_unclaimed=$(echo "$frontend_unclaimed" | grep -vE "^${project}/" || true)

    # Reset per iteration: a leaked exit code from the previous project would be
    # read as this one's verdict.
    tsc_exit=0
    vitest_exit=0
    project_dir="$REPO_ROOT/$project"

    log "${project}: frontend files changed — running vue-tsc (timeout ${TYPE_CHECK_TIMEOUT}s)"
    if node_modules_usable "$project_dir"; then
      tsc_output=$(
        cd "$project_dir" \
        && timeout "$TYPE_CHECK_TIMEOUT" npm run --silent type-check 2>&1
      ) || tsc_exit=$?

      if [ "$tsc_exit" = "124" ]; then
        did_not_run "vue-tsc (${project})" "${TYPE_CHECK_TIMEOUT}"
      elif [ "$tsc_exit" != "0" ] && ! echo "$tsc_output" | grep -q "error TS"; then
        # A non-zero exit with no diagnostic at all is a broken invocation, not a
        # clean tree. Reporting it as "no errors in changed files" below would be
        # a verdict from a check that never produced one.
        could_not_run "vue-tsc (${project})" \
          "exited ${tsc_exit} without a single 'error TS' line: $(echo "$tsc_output" | tail -1)"
      elif [ "$tsc_exit" != "0" ]; then
        # Distinguish errors in changed files (block) vs pre-existing (warn)
        changed_ts_files=$(echo "$project_changed" | sed "s|^${project}/||" || true)
        if [ -n "$changed_ts_files" ]; then
          # Show only errors that mention any of the changed files
          # #17579 review: each changed path was an UNBOUNDED fixed-string
          # pattern, so a changed `src/Foo.ts` matched a diagnostic for
          # `src/Foo.tsx` and blocked the push over an error in a file nobody
          # touched. tsc writes a diagnostic as `<path>(line,col): error TS...`
          # or `<path>:line:col - error TS...`, so requiring the path to be
          # followed by `(` or `:` is the filename boundary.
          #
          # NOT anchored to column 1, deliberately (the review's suggestion
          # was): that assumes the diagnostic begins with the path, and an
          # absolute-path diagnostic would then match nothing -- turning a
          # false BLOCK into a false PASS, which is the wrong direction for a
          # gate whose misses are invisible. A delimiter suffix gets the
          # boundary without assuming where the path sits on the line.
          boundaried=$(echo "$changed_ts_files" | awk 'NF { print $0 "("; print $0 ":" }')
          relevant=$(echo "$tsc_output" \
            | grep "error TS" \
            | grep -F -f <(echo "$boundaried") || true)
          if [ -n "$relevant" ]; then
            fail "vue-tsc errors in CHANGED files (${project}, #5142):"
            echo "$relevant" | head -20 >&2
            EXIT_CODE=1
          else
            ok "vue-tsc (${project}): no errors in changed files (other errors are pre-existing)"
          fi
        fi
      else
        ok "vue-tsc (${project}): 0 errors"
      fi
    else
      # #16912: "skipping" was a warning and a zero exit, so a frontend change
      # made where node_modules does not resolve -- every git worktree, before
      # scripts/hooks/post-checkout started linking it -- pushed with NO type
      # check and nothing in the transcript that read as unverified. A check
      # that could not look is not a check that found nothing.
      could_not_run "vue-tsc (${project})" \
        "${project}/node_modules is missing or cannot be traversed, so its toolchain is unreachable (a fresh worktree gets it linked by scripts/hooks/post-checkout; #17573 is the present-but-mode-644 case)"
    fi

    # Targeted test runs for changed test files + sibling __tests__/.
    # vitest runs with cwd inside this project, so every path here is relative
    # to it, not to the repo root $changed uses.
    # #16912: `.spec.ts` too, not just `.test.ts`. vitest.config.ts runs both,
    # and 51 of autobot-frontend's test files are named `.spec.ts` -- every one
    # of them could be changed, pushed, and never selected here, which reads in
    # the transcript exactly like a push whose tests were run and passed.
    # #17575: the existence filter applies to BOTH selectors and the path is
    # interpolated by THIS shell. It used to sit only on composable_tests and to
    # expand `$REPO_ROOT` inside a single-quoted `sh -c`, where that variable is
    # unset -- nothing in this file exports it -- so the selector matched nothing
    # for every input, and its absence was indistinguishable from success.
    test_files=$(echo "$project_changed" \
      | grep -E '\.(test|spec)\.ts$' \
      | sed "s|^${project}/||" \
      | while IFS= read -r rel; do [ -f "$project_dir/$rel" ] && echo "$rel"; done \
      | head -10 || true)
    # Also test corresponding __tests__/ for any composable changes
    composable_tests=$(echo "$project_changed" \
      | grep -E 'composables/.*\.ts$' \
      | grep -v '\.test\.' \
      | sed "s|^${project}/||" \
      | sed -E 's|(composables)/(.+)\.ts$|\1/__tests__/\2.test.ts|' \
      | while IFS= read -r rel; do [ -f "$project_dir/$rel" ] && echo "$rel"; done || true)
    all_tests=$(printf "%s\n%s" "$test_files" "$composable_tests" \
      | sort -u | grep -v '^$' || true)

    if [ -n "$all_tests" ] && node_modules_usable "$project_dir"; then
      log "${project}: running vitest on relevant tests (timeout ${TEST_TIMEOUT}s):"
      echo "$all_tests" | sed 's/^/    /' >&2
      vitest_output=$(
        cd "$project_dir" \
        && timeout "$TEST_TIMEOUT" npx vitest run $(echo "$all_tests") 2>&1
      ) || vitest_exit=$?

      if [ "$vitest_exit" = "124" ]; then
        did_not_run "vitest (${project})" "${TEST_TIMEOUT}"
      elif [ "$vitest_exit" != "0" ]; then
        fail "vitest failures (${project}, #5142):"
        echo "$vitest_output" | tail -25 >&2
        EXIT_CODE=1
      else
        ok "vitest (${project}): all relevant tests pass"
      fi
    elif [ -n "$all_tests" ]; then
      # #16912: this branch did not exist -- tests were selected, node_modules
      # was absent, and the hook fell through silently, so the push looked
      # exactly like one where the tests had passed.
      could_not_run "vitest (${project})" \
        "${project}/node_modules is missing or cannot be traversed, so the $(echo "$all_tests" | grep -c .) selected test file(s) did not run"
    fi
  done

  # #17574: `.ts`/`.vue` outside a project that declares a `type-check` script --
  # libs/autobot-ui, libs/autobot-sdk-ts, the MCP tools. None carries an install
  # or that script, so nothing here can check them; they used to be handed to
  # autobot-frontend's invocation, which is how a foreign path reached a vitest
  # that could not see it. Recorded rather than dropped: not checking is a fact
  # about this push, and a silent skip is the failure mode #16912 describes.
  if [ -n "$frontend_unclaimed" ]; then
    could_not_run "vue-tsc/vitest (unclaimed trees)" \
      "$(echo "$frontend_unclaimed" | grep -c .) changed .ts/.vue file(s) are outside ${FRONTEND_PROJECTS// /, }, which are the only trees declaring a type-check script: $(echo "$frontend_unclaimed" | head -3 | tr '\n' ' ')"
  fi

  # ----- Backend (Python) -------------------------------------------------
  # #16711: tools/lint/prepush_selection.py chooses the tests and says why. It
  # picks changed tests under every pytest.ini python_files pattern (test_*.py
  # was missed before) and the co-located foo_test.py of a changed foo.py, and
  # drops tests that no longer exist (#15751) or that pytest.ini ignores
  # (#16019). A failed selection blocks the push: an empty list would read as
  # "nothing to verify".
  sel_err=$(mktemp)
  selection=$(printf '%s\n' "$changed" | (cd "$REPO_ROOT" && "$PYTEST_PYTHON" -m tools.lint.prepush_selection) 2>"$sel_err")
  selection_exit=$?
  if [ "$selection_exit" != "0" ]; then
    fail "pytest selection failed (#16715) -- this push is NOT verified:"
    tail -15 "$sel_err" >&2
    EXIT_CODE=1
    selection=""
  fi
  rm -f "$sel_err"
  all_py_tests=$(printf '%s\n' "$selection" | cut -f1 | grep -v '^$' || true)
  if [ -n "$all_py_tests" ]; then
    # The selection can outgrow the changeset, so the budget follows it too (#15985).
    selected_count=$(printf '%s\n' "$all_py_tests" | grep -c . || true)
    TEST_TIMEOUT=$(( TEST_TIMEOUT + (selected_count * 2) ))
    [ "$TEST_TIMEOUT" -gt 600 ] && TEST_TIMEOUT=600

    # #16069: autobot-slm-backend must be a SEPARATE pytest invocation.
    # pytest.ini says so in as many words: the two backends define top-level
    # packages with identical names (api, services, user_management,
    # middleware, migrations), so whichever collects first binds those dotted
    # names in sys.modules for the rest of the session. CI already obeys this
    # -- two invocations, one for `autobot-backend autobot_shared
    # autobot-tts-worker repo_tests` and one for `autobot-slm-backend` alone.
    # This hook did not, so a changeset touching both trees was tested in a
    # shape CI never runs and pytest.ini forbids.
    #
    # What that cost: slm-backend's conftest installs its stubs at import, so
    # in a combined session `sqlalchemy`, `models` and `models.database` stay
    # MagicMocks while repo_tests collects afterwards. The leak guard caught it
    # and blocked the push -- correctly, and for a condition the changeset had
    # not introduced. The conftest is unchanged from base; the invocation was
    # the defect. Splitting here is not a workaround for that guard: it stops
    # producing the state the guard exists to report.
    slm_py_tests=$(echo "$all_py_tests" | grep -E '^autobot-slm-backend/' || true)
    other_py_tests=$(echo "$all_py_tests" | grep -vE '^autobot-slm-backend/' || true)

    if [ -n "$all_py_tests" ] && command -v pytest >/dev/null 2>&1; then
      log "running pytest on (why each was selected, #16711):"
      printf '%s\n' "$selection" | awk -F'\t' 'NF { printf "    %s  (%s)\n", $1, $2 }' >&2
      [ -n "$slm_py_tests" ] && [ -n "$other_py_tests" ] && \
        log "  (two invocations: autobot-slm-backend separately, per pytest.ini #13084)"

      pytest_failed=0
      pytest_timed_out=0
      pytest_unrunnable=""
      for group in "$other_py_tests" "$slm_py_tests"; do
        [ -z "$group" ] && continue
        group_exit=0
        group_output=$(
          # -m "not reach_floor" (#17810): repo_tests/reach_declarations_test.py walks the
          # REAL tree once per declared reach floor, and was 156.75s of a 214s budget on its
          # own -- a cost that grows with every new declare() and is paid by pushes that did
          # not add one. The empty-tree proof, which is what makes a floor provable, carries
          # no marker and still runs here; the floor-versus-population half is a ratchet and
          # runs in CI. `reach_declarations_test` asserts BOTH ends of that split, so the
          # marker cannot quietly become a way of running the check nowhere.
          timeout "$TEST_TIMEOUT" "$PYTEST_PYTHON" -m pytest -xvs -m "not reach_floor" $group 2>&1
        ) || group_exit=$?
        if [ "$group_exit" = "124" ]; then
          pytest_timed_out=1
        elif [ "$group_exit" != "0" ]; then
          # The interpreter floor is not a test failure. Below Python 3.11 a
          # conftest that reaches one of these takes the whole group down at
          # COLLECT time -- before a single assertion runs:
          #   - llc/scheduler/base.py refuses to import (asyncio.Task.cancelling)
          #   - enum.StrEnum does not exist (3.11+), which any module importing
          #     it propagates to every co-located test (#18058)
          # Each is matched as its own specific string, never as a bare
          # "ImportError": a real broken import in the changeset must still
          # block. A new floor symptom is one more branch here, not a looser
          # pattern.
          floor_symptom=""
          if printf '%s' "$group_output" | grep -q 'requires asyncio.Task.cancelling()'; then
            floor_symptom="llc/scheduler/base.py requires asyncio.Task.cancelling()"
          elif printf '%s' "$group_output" | grep -q "cannot import name 'StrEnum' from 'enum'"; then
            floor_symptom="enum.StrEnum is 3.11+"
          fi
          if [ -n "$floor_symptom" ]; then
            pytest_unrunnable="the interpreter floor: $("$PYTEST_PYTHON" -V 2>&1) is below the 3.11+ the platform requires ($floor_symptom; CI is 3.14)"
          else
            pytest_failed=1
            fail "pytest failures (#5142):"
            echo "$group_output" | tail -25 >&2
          fi
        fi
      done

      if [ "$pytest_failed" != "0" ]; then
        EXIT_CODE=1
      elif [ "$pytest_timed_out" != "0" ]; then
        did_not_run "pytest" "${TEST_TIMEOUT}"
      elif [ -n "$pytest_unrunnable" ]; then
        could_not_run "pytest" "$pytest_unrunnable"
      else
        ok "pytest: all relevant tests pass"
      fi
    fi
  fi

done

if [ "$EXIT_CODE" != "0" ]; then
  fail "Push BLOCKED. Fix the failures above or use 'git push --no-verify' to bypass."
fi

exit "$EXIT_CODE"
