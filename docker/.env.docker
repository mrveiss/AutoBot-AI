# AutoBot Docker Default Environment (#1809, #2553)
# Copy to .env in project root to customize
#
# AutoBot - AI-Powered Automation Platform
# Copyright (c) 2025 mrveiss
# Author: mrveiss

# --- LLM Provider ---
AUTOBOT_LLM_PROVIDER=ollama
AUTOBOT_OLLAMA_HOST=autobot-ollama
AUTOBOT_OLLAMA_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_DEFAULT_LLM_MODEL=qwen3.5:9b
AUTOBOT_EMBEDDING_MODEL=nomic-embed-text:latest

# --- Agent Configuration — 6-tier model mapping (#2553) ---
# Tier 6: Quality (user-facing chat, research, code)
AUTOBOT_CHAT_PROVIDER=ollama
AUTOBOT_CHAT_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_CHAT_MODEL=qwen3.5:9b

# Tier 1: Routing (orchestration)
AUTOBOT_ORCHESTRATOR_PROVIDER=ollama
AUTOBOT_ORCHESTRATOR_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_ORCHESTRATOR_MODEL=llama3.2:1b

# Tier 2: Classification (intent detection)
AUTOBOT_CLASSIFICATION_PROVIDER=ollama
AUTOBOT_CLASSIFICATION_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_CLASSIFICATION_MODEL=gemma2:2b

# Tier 3: Light Processing (extraction, formatting)
AUTOBOT_LIGHT_PROCESSING_MODEL=phi3:mini

# Tier 4: Instruction Following (RAG, entity extraction)
AUTOBOT_INSTRUCTION_MODEL=mistral:7b-instruct
AUTOBOT_RAG_PROVIDER=ollama
AUTOBOT_RAG_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_RAG_MODEL=mistral:7b-instruct

# Tier 5: System/Uncensored (commands, security)
AUTOBOT_SYSTEM_MODEL=dolphin-llama3:8b

# Tier 6: Quality (code, analysis, research)
AUTOBOT_CODE_GENERATION_PROVIDER=ollama
AUTOBOT_CODE_GENERATION_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_CODE_GENERATION_MODEL=qwen3.5:9b

AUTOBOT_DATA_ANALYSIS_PROVIDER=ollama
AUTOBOT_DATA_ANALYSIS_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_DATA_ANALYSIS_MODEL=qwen3.5:9b

AUTOBOT_SUMMARIZATION_PROVIDER=ollama
AUTOBOT_SUMMARIZATION_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_SUMMARIZATION_MODEL=qwen3.5:9b

AUTOBOT_TRANSLATION_PROVIDER=ollama
AUTOBOT_TRANSLATION_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_TRANSLATION_MODEL=qwen3.5:9b

AUTOBOT_SENTIMENT_ANALYSIS_PROVIDER=ollama
AUTOBOT_SENTIMENT_ANALYSIS_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_SENTIMENT_ANALYSIS_MODEL=qwen3.5:9b

# Light processing tier (extraction, formatting)
AUTOBOT_KNOWLEDGE_EXTRACTION_PROVIDER=ollama
AUTOBOT_KNOWLEDGE_EXTRACTION_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_KNOWLEDGE_EXTRACTION_MODEL=phi3:mini

AUTOBOT_KNOWLEDGE_RETRIEVAL_PROVIDER=ollama
AUTOBOT_KNOWLEDGE_RETRIEVAL_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_KNOWLEDGE_RETRIEVAL_MODEL=phi3:mini

AUTOBOT_KB_LIBRARIAN_PROVIDER=ollama
AUTOBOT_KB_LIBRARIAN_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_KB_LIBRARIAN_MODEL=phi3:mini

# Quality tier (vision — placeholder, moondream available)
AUTOBOT_IMAGE_ANALYSIS_PROVIDER=ollama
AUTOBOT_IMAGE_ANALYSIS_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_IMAGE_ANALYSIS_MODEL=qwen3.5:9b

AUTOBOT_AUDIO_PROCESSING_PROVIDER=ollama
AUTOBOT_AUDIO_PROCESSING_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_AUDIO_PROCESSING_MODEL=qwen3.5:9b

# System/uncensored tier (command execution)
AUTOBOT_SYSTEM_COMMANDS_PROVIDER=ollama
AUTOBOT_SYSTEM_COMMANDS_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_SYSTEM_COMMANDS_MODEL=dolphin-llama3:8b

# System/uncensored tier (failsafe)
AUTOBOT_LLM_FAILSAFE_PROVIDER=ollama
AUTOBOT_LLM_FAILSAFE_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_LLM_FAILSAFE_MODEL=dolphin-llama3:8b

# --- LlamaIndex / RAG ---
AUTOBOT_LLAMAINDEX_LLM_ENDPOINT=http://autobot-ollama:11434
AUTOBOT_LLAMAINDEX_EMBEDDING_ENDPOINT=http://autobot-ollama:11434

# --- Database ---
AUTOBOT_DB_USER=autobot
AUTOBOT_DB_PASSWORD=autobot
AUTOBOT_DB_NAME=autobot_slm

# --- TLS ---
# Docker-specific cert path override: prevents the fleet .env value
# (infrastructure/shared/certs) from breaking compose volume validation.
# For HTTPS, also uncomment AUTOBOT_DOCKER_NGINX_CONF and run:
#   bash docker/certs/generate-self-signed.sh
# AUTOBOT_DOCKER_NGINX_CONF=./docker/nginx/nginx-ssl.conf
AUTOBOT_TLS_CERT_DIR=./docker/certs

# --- Logging ---
AUTOBOT_LOG_LEVEL=INFO
