{
  "name": "slm-admin",
  "version": "1.0.0",
  "description": "Service Lifecycle Manager Admin UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:slm": "VITE_API_URL=/slm vite build",
