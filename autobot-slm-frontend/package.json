{
  "name": "slm-admin",
  "version": "1.0.0",
  "description": "Service Lifecycle Manager Admin UI",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:slm": "VITE_API_URL=/slm vite build",
    "build:check": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit -p tsconfig.json",
    "storybook": "VITE_API_URL=/slm storybook dev -p 6007",
    "build-storybook": "VITE_API_URL=/slm storybook build"
  },
  "dependencies": {
    "@autobot/terminal": "file:../autobot-plugins/terminal",
    "@autobot/vnc": "file:../autobot-plugins/vnc",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.16.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.32",
    "vue-i18n": "^11.4.4",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@storybook/addon-docs": "^10.4.0",
    "@storybook/vue3": "^10.4.2",
    "@storybook/vue3-vite": "^10.4.1",
    "@tailwindcss/postcss": "^4.2.2",
    "@types/node": "^25.9.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-plugin-vue": "^10.9.2",
    "postcss": "^8.5.15",
    "storybook": "^10.4.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.13",
    "vue-tsc": "^3.3.2"
  }
}
