{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2020", "ES2021", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@autobot/ui": ["../libs/autobot-ui/index.ts"],
      "@autobot/backend-contract": ["../autobot-frontend/src/types/generated/api.ts"],
      "@shared/*": ["../autobot_shared/*"],
      "vue": ["./node_modules/vue/dist/vue.d.ts"],
      "dompurify": ["./node_modules/dompurify/dist/purify.es.d.mts"],
      "reka-ui": ["./node_modules/reka-ui/dist/index.d.ts"],
      "@autobot/terminal": ["./src/types/autobot-terminal.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
