# AutoBot Localhost Development Configuration
# OVERLAY on .env.base (#18555): load .env.base first; this file holds only what differs.
# Hand-maintained: generate-env-files.py is broken pending #18565 and, once repaired, writes
# overlay-only output (it strips keys that repeat .env.base).
# Use this for local development with all services on localhost

# Core Infrastructure - All Local
AUTOBOT_BACKEND_HOST=127.0.0.1
AUTOBOT_FRONTEND_HOST=127.0.0.1
AUTOBOT_REDIS_HOST=127.0.0.1
AUTOBOT_OLLAMA_HOST=0.0.0.0
AUTOBOT_AI_STACK_HOST=127.0.0.1
AUTOBOT_NPU_WORKER_HOST=127.0.0.1
AUTOBOT_BROWSER_SERVICE_HOST=127.0.0.1

# Service Ports (Same as distributed)

# Redis database numbers: redis-databases.yaml (#19232). Set AUTOBOT_REDIS_DB_<NAME> only
# where this deployment differs; a copy of the whole table here is a second source.

# Service URLs (Localhost)
AUTOBOT_BACKEND_URL=http://127.0.0.1:8001
AUTOBOT_FRONTEND_URL=http://127.0.0.1:5173
AUTOBOT_REDIS_URL=redis://127.0.0.1:6379
AUTOBOT_OLLAMA_URL=http://0.0.0.0:11434
AUTOBOT_AI_STACK_URL=http://127.0.0.1:8080
AUTOBOT_NPU_WORKER_URL=http://127.0.0.1:8081
AUTOBOT_BROWSER_SERVICE_URL=http://127.0.0.1:9001

# WebSocket Configuration
AUTOBOT_WS_URL=ws://127.0.0.1:8001/ws

# Development Mode Configuration
# Profile "dev-localhost" (autobot_shared/deployment_profile.py, #19316); unset would mean production.
AUTOBOT_ENVIRONMENT=development
AUTOBOT_DEPLOYMENT_MODE=local
AUTOBOT_DEBUG=true
AUTOBOT_LOG_LEVEL=INFO

# Performance Settings
AUTOBOT_LLM_TIMEOUT=30

# Hardware Acceleration Compatibility
TF_USE_LEGACY_KERAS=1
KERAS_BACKEND=tensorflow

# Legacy Compatibility
REDIS_HOST=127.0.0.1
OLLAMA_HOST=0.0.0.0
OLLAMA_PORT=11434
