# AutoBot Network Configuration
# OVERLAY on .env.base (#18555): load .env.base first; this file holds only what differs.
# Hand-maintained: generate-env-files.py is broken pending #18565 and, once repaired, writes
# overlay-only output (it strips keys that repeat .env.base).
# Production-ready network settings
# NOTE: Host IPs are set at deploy time — not stored in version control.
# Use 'python scripts/generate-env-files.py' after setting hosts in complete.yaml.

# Service Host IP Addresses — set these to your actual deployment IPs

# Service Ports (Standardized)
AUTOBOT_WEBSOCKET_PORT=8001

# Redis database numbers: redis-databases.yaml (#19232). Set AUTOBOT_REDIS_DB_<NAME> only
# where this deployment differs; a copy of the whole table here is a second source.

# Network Configuration — set at install time via install.sh
DOCKER_SUBNET=
DOCKER_GATEWAY=

# Service URL Construction — populated at deploy time from hosts above
BACKEND_URL=
FRONTEND_URL=
REDIS_URL=
OLLAMA_URL=
AI_STACK_URL=
NPU_WORKER_URL=
BROWSER_SERVICE_URL=

# Legacy Compatibility
REDIS_HOST_IP=
BACKEND_HOST_IP=
FRONTEND_HOST_IP=
OLLAMA_HOST_IP=
OLLAMA_PORT=11434
