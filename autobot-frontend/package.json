{
  "name": "autobot-vue",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p \"build-only {@}\" --",
    "build:embed": "vite build --config vite.embed.config.ts && node scripts/embed-sri.mjs",
    "build-with-typecheck": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:unit:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:coverage:watch": "vitest --coverage",
    "test:coverage:ui": "vitest --coverage --ui",
    "prepare": "cypress install",
    "test:e2e": "start-server-and-test preview http://localhost:5173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 5173' http://localhost:5173 'cypress open --e2e'",
    "test:playwright": "playwright test",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:report": "playwright show-report",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "run-s test:unit test:integration test:playwright",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "check:locales": "python3 scripts/check-locale-completeness.py",
    "check-ts-delta": "bash scripts/check-ts-delta.sh",
    "lint:oxlint": "oxlint . --fix -D correctness --ignore-path .gitignore",
    "lint:eslint": "eslint . --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "gen:types": "openapi-typescript http://127.0.0.1:8001/openapi.json -o src/types/generated/api.ts --additional-properties",
    "verify:types": "git diff --exit-code src/types/generated/api.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@autobot/terminal": "file:../autobot-plugins/terminal",
    "@autobot/vnc": "file:../autobot-plugins/vnc",
    "@fontsource/inter": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@heroicons/vue": "^2.2.0",
    "@ricky0123/vad-web": "^0.0.30",
    "@tanstack/vue-virtual": "^3.13.24",
    "@testing-library/dom": "^10.4.1",
    "@tsconfig/node18": "^18.2.6",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "3d-force-graph": "^1.80.0",
    "apexcharts": "^5.12.0",
    "cytoscape": "^3.33.3",
    "cytoscape-fcose": "^2.2.0",
    "dompurify": "^3.4.5",
    "highlight.js": "^11.10.0",
    "npm-normalize-package-bin": "^5.0.0",
    "onnxruntime-web": "^1.26.0",
    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "three": "^0.184.0",
    "three-spritetext": "^1.10.0",
    "vega": "^5.30.0",
    "vega-embed": "^6.29.0",
    "vega-lite": "5.23.0",
    "vue": "^3.5.34",
    "vue-i18n": "^11.3.1",
    "vue-router": "^5.0.4",
    "vue3-apexcharts": "^1.11.1",
    "wavesurfer.js": "^7.12.7"
  },
  "overrides": {
    "minimatch": ">=9.0.7",
    "uuid": "^14.0.0",
    "qs": ">=6.15.2",
    "vega-lite": "5.23.0",
    "vega-embed": {
      "vega-lite": "5.23.0"
    },
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@typescript-eslint/utils": {
      "typescript": "$typescript"
    },
    "@vue/eslint-config-typescript": {
      "typescript": "$typescript"
    }
  },
  "devDependencies": {
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.59.1",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/vue3": "^10.3.6",
    "@storybook/vue3-vite": "^10.3.6",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/postcss": "^4.3.0",
    "@tailwindcss/typography": "^0.5.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/aria-query": "^5.0.4",
    "@types/chai": "^5.2.3",
    "@types/cookie": "^1.0.0",
    "@types/cytoscape": "^3.31.0",
    "@types/deep-eql": "^4.0.2",
    "@types/dompurify": "^3.2.0",
    "@types/estree": "^1.0.8",
    "@types/jsdom": "^28.0.1",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^25.9.0",
    "@types/sinonjs__fake-timers": "^15.0.1",
    "@types/sizzle": "^2.3.10",
    "@types/statuses": "^2.0.6",
    "@types/three": "^0.184.0",
    "@types/tough-cookie": "^4.0.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitejs/plugin-vue-jsx": "^5.1.5",
    "@vitest/coverage-v8": "^4.1.8",
    "@vitest/eslint-plugin": "^1.6.15",
    "@vitest/ui": "^4.1.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "cypress": "^15.16.0",
    "esbuild": "^0.28.0",
    "eslint": "^10.2.1",
    "eslint-plugin-cypress": "^6.4.0",
    "eslint-plugin-oxlint": "~1.66.0",
    "eslint-plugin-vue": "~10.9.0",
    "happy-dom": "^20.9.0",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "mock-socket": "^9.3.1",
    "msw": "^2.13.6",
    "npm-run-all2": "^8.0.4",
    "openapi-typescript": "^7.13.0",
    "oxlint": "~1.66.0",
    "playwright": "^1.60.0",
    "postcss": "^8.5.8",
    "prettier": "3.8.3",
    "start-server-and-test": "^3.0.4",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.9.0",
    "vite": "^8.0.9",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.8"
  }
}
