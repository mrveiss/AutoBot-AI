{
  "extends": "./node_modules/@vue/tsconfig/tsconfig.dom.json",
  "include": ["env.d.ts", "src/**/*", "src/**/*.vue", "src/types/global.d.ts", "src/shims-vue.d.ts"],
  "exclude": ["src/**/__tests__/*", "src/**/*.test.ts", "src/**/*.spec.ts", "src/test/**/*"],
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./src/*"],
      "vue": ["./node_modules/vue"],
      "pinia": ["./node_modules/pinia"],
      "@xterm/xterm": ["./node_modules/@xterm/xterm"],
      "@xterm/addon-fit": ["./node_modules/@xterm/addon-fit"],
      "@xterm/addon-web-links": ["./node_modules/@xterm/addon-web-links"]
    }
  }
}
