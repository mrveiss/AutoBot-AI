# AutoBot Frontend Environment Configuration
# Copy this file to .env and adjust values for your environment

# API Configuration (#19821, #12339)
# By default the GUI talks to the backend same-origin, through nginx (proxy mode), and
# uses the page's own protocol. Leave VITE_API_BASE_URL unset for that.
# These two must agree with the repository root .env.example and with
# autobot_shared/ssot_config.py PortConfig.backend (repo_tests check this).
VITE_HTTP_PROTOCOL=http
VITE_BACKEND_PORT=8001

# Cross-origin backend only (also add it to the CSP connect-src):
# VITE_API_BASE_URL=https://<BACKEND_HOST>
# VITE_WS_BASE_URL=wss://<BACKEND_HOST>/ws

# Timeouts (milliseconds)
VITE_API_TIMEOUT=60000
VITE_API_RETRY_ATTEMPTS=3

# Development Settings
VITE_ENABLE_DEBUG=false
VITE_ENABLE_RUM=true

# Theme (Issue #10461 / #9274)
# Default theme variant for a fresh user (no saved choice). The user GUI ships the
# Refined palette ("default"). Set to "ember" for the warm marigold palette that was
# the default before the Refined redesign (#18161).
# VITE_DEFAULT_THEME_VARIANT=default
