# AutoBot Frontend Environment Configuration
# Copy this file to .env and adjust values for your environment

# API Configuration
# IMPORTANT: Set VITE_HTTP_PROTOCOL=https if backend uses SSL (default since Issue #868)
VITE_HTTP_PROTOCOL=https
VITE_BACKEND_PORT=8443
# Set VITE_API_BASE_URL to your backend host (e.g. https://192.168.1.10:8443)
VITE_API_BASE_URL=https://<BACKEND_HOST>:8443
VITE_WS_BASE_URL=wss://<BACKEND_HOST>:8443/ws

# Timeouts (milliseconds)
VITE_API_TIMEOUT=30000
VITE_API_RETRY_ATTEMPTS=3

# Development Settings
VITE_ENABLE_DEBUG=false
VITE_ENABLE_RUM=true

# HTTP-only override (local dev without SSL)
# VITE_HTTP_PROTOCOL=http
# VITE_BACKEND_PORT=8001
# VITE_API_BASE_URL=http://localhost:8001
# VITE_WS_BASE_URL=ws://localhost:8001/ws

# Feature flags — gate nav items defined in src/config/navItems.ts.
# An item with a `featureFlag` is shown ONLY when its VITE_FEATURE_<NAME>='true'.
# Defaults below keep currently-shipped nav items visible (#9984).
# Transcriber primary-nav item (#9044): set to 'false' to hide it.
VITE_FEATURE_TRANSCRIBER=true
# Live Canvas profile-menu item (GH#8758): opt-in, defaults off.
# VITE_FEATURE_CANVAS=true
