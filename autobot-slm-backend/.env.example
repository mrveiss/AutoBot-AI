# SLM Server Environment Configuration Template
#
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Encryption key for sensitive credential storage
# IMPORTANT: This key encrypts SSH passwords and other sensitive data
# Generate a new key with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Production deployments: set via Ansible (EnvironmentFile=/etc/autobot/slm-secrets.env)
# Dev/manual: if left empty, a key is auto-generated and persisted to data/.slm_keys
#             on first startup so it survives restarts. (Issue #1726)
SLM_ENCRYPTION_KEY=

# JWT secret key for authentication
# Generate a new key with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# Production deployments: set via Ansible (EnvironmentFile=/etc/autobot/slm-secrets.env)
# Dev/manual: if left empty, a key is auto-generated and persisted to data/.slm_keys
#             on first startup so it survives restarts. (Issue #1726)
SLM_SECRET_KEY=

# External URL for node agents to reach SLM backend
# This is the address remote nodes use to connect back to the SLM server
# Typically the nginx reverse proxy address
SLM_EXTERNAL_URL=https://your-slm-server-ip
