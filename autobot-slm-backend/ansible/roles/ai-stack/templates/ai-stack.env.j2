# AI Stack Environment

# #14544/#14575: ai_api_server.py imports agents.base_agent, which imports
# autobot_shared.ssot_config directly (`from autobot_shared.ssot_config import
# config`) -- autobot-ai-stack.service.j2's own PYTHONPATH comment already
# says "ai_api_server imports autobot_shared ... (#10121)". Whether the walk
# in autobot_shared.paths.project_root() finds a `.env` for this unit is
# topology-dependent: with the ai-stack role's own default
# (backend_install_dir: /opt/autobot/autobot-backend) it happens to land on a
# directory that carries one; with the flattened topology
# deploy-backend-local.yml/deploy-backend-remote.yml set
# (backend_install_dir: /opt/autobot) it does not, and this unit raises
# ProjectRootUndeterminable and never starts. ai_install_dir is stable across
# both topologies, so declare the root explicitly instead of depending on
# which one is in effect.
AUTOBOT_PROJECT_ROOT={{ ai_install_dir | dirname }}

# ChromaDB
CHROMADB_HOST={{ chromadb_host }}
CHROMADB_PORT={{ chromadb_port }}
CHROMADB_PERSIST_DIR={{ chromadb_persist_dir }}

# Ollama (on backend node - resolved from inventory)
AUTOBOT_OLLAMA_HOST={{ ollama_host }}
AUTOBOT_OLLAMA_PORT={{ ollama_port }}

# AI Stack API
AI_SERVER_HOST={{ ai_host }}
AI_SERVER_PORT={{ ai_port }}

# Redis
REDIS_HOST={{ ai_redis_host }}
REDIS_PORT={{ ai_redis_port }}
{% if ai_redis_password | length > 0 %}
REDIS_PASSWORD={{ ai_redis_password }}
{% endif %}

# Agent LLM configuration — all three explicit functions raise AgentConfigurationError if unset.
# PROVIDER, ENDPOINT, and MODEL are required for every agent that calls get_agent_*_explicit().
# Agents: chat, rag, classification, audio_processing, code_generation, data_analysis,
#         image_analysis, kb_librarian, knowledge_extraction, knowledge_retrieval,
#         llm_failsafe, sentiment_analysis, summarization, translation, system_commands

AUTOBOT_CHAT_PROVIDER={{ ai_chat_provider | default('ollama') }}
AUTOBOT_CHAT_ENDPOINT={{ ai_chat_endpoint }}
AUTOBOT_CHAT_MODEL={{ ai_chat_model }}

AUTOBOT_RAG_PROVIDER={{ ai_rag_provider | default('ollama') }}
AUTOBOT_RAG_ENDPOINT={{ ai_rag_endpoint }}
AUTOBOT_RAG_MODEL={{ ai_rag_model }}

AUTOBOT_CLASSIFICATION_PROVIDER={{ ai_classification_provider | default('ollama') }}
AUTOBOT_CLASSIFICATION_ENDPOINT={{ ai_classification_endpoint }}
AUTOBOT_CLASSIFICATION_MODEL={{ ai_classification_model }}

AUTOBOT_AUDIO_PROCESSING_PROVIDER=ollama
AUTOBOT_AUDIO_PROCESSING_ENDPOINT={{ ai_chat_endpoint }}
AUTOBOT_AUDIO_PROCESSING_MODEL={{ ai_audio_processing_model }}

AUTOBOT_CODE_GENERATION_PROVIDER=ollama
