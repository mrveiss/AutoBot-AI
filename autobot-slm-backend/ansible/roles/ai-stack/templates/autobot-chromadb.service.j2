[Unit]
Description=AutoBot ChromaDB Vector Database
After=network.target

[Service]
Type=simple
User={{ ai_user }}
Group={{ ai_group }}
WorkingDirectory={{ ai_install_dir }}
Environment="PATH={{ ai_install_dir }}/venv/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PROTOCOL_BUFFERS_PYTHON_IMPLEMENTATION=python"
# #13870: three settings the redis role's unit had and this one did not. Which
# template won was decided by role order, so a host could run chroma with any
# combination of them — and nothing made that visible.
#
# Chroma's telemetry is ON by default and posts to an external endpoint. Nobody
# chose that; the other unit had already opted out.
Environment="ANONYMIZED_TELEMETRY=FALSE"
# StandardOutput below appends to a FILE, which is fully buffered rather than
# line-buffered. Without this, chroma's own diagnostics sit in a 4-8KB buffer —
# so the log an operator reads during an incident lags the incident.
Environment="PYTHONUNBUFFERED=1"
EnvironmentFile=/etc/autobot/autobot-ai-stack.env
# #12513: chroma's server-side token auth. The credential is deliberately NOT
# inlined here as Environment=: this unit is deployed 0644 and world-readable, so
# an inline value publishes the token to every local user. It arrives instead
# through the env file below, rendered 0600 root:root by
# _shared/tasks/write_chromadb_authn_env.yml immediately before this template.
#
# No `-` prefix, on purpose. The optional form is exactly why a missing
# credential produced a running-but-unauthenticated chroma: systemd silently
# tolerated the absent file and the service came up enforcing nothing. Mandatory
# turns that into a visible start failure. It is safe because the env file is
# written unconditionally (with no keys when no token is configured) by the same
# role, in the task immediately preceding this one, on every path that renders
# this unit.
EnvironmentFile={{ chromadb_authn_env_file }}
ExecStart={{ ai_install_dir }}/venv/bin/chroma run --host {{ chromadb_host }} --port {{ chromadb_port }} --path {{ chromadb_persist_dir }}
# #13870: on-failure, matching the redis role's unit. These differed
# (always vs on-failure), so the unit's FAILURE BEHAVIOUR changed with
# role order too, not just its path — and #4090 was about a unit that
# restarted forever instead of reaching `failed`.
Restart=on-failure
RestartSec=10
# #4090: without these, a unit that can never exec restarts forever and stays
# out of `systemctl --failed`, so the one thing an operator checks cannot see it
# (chromadb: 1681 restarts over ~4h45m, invisible). systemd's OWN defaults do not
# help — DefaultStartLimitIntervalSec=10s with DefaultStartLimitBurst=5 needs 5
# restarts inside 10s, and RestartSec spaces them further apart than that, so the
# rate never reaches the limit. The window has to be wider than
# RestartSec * StartLimitBurst for the limit to be reachable at all.
StartLimitIntervalSec=120
StartLimitBurst=5
# #13870/#13765: without a cgroup limit, `memory.max` reads "max" and the
# headroom metric #13765 added has nothing to divide by — the unit is invisible
# to the alerting built for exactly this failure. MemoryHigh throttles and feeds
# `memory.events high`; MemoryMax is left unset by default because a hard cap on
# a service that has never had one kills it the moment it exceeds the number.
MemoryAccounting=yes
{% if chromadb_memory_high %}
MemoryHigh={{ chromadb_memory_high }}
{% endif %}
{% if chromadb_memory_max %}
MemoryMax={{ chromadb_memory_max }}
{% endif %}
StandardOutput=append:{{ ai_log_dir }}/chromadb.log
StandardError=append:{{ ai_log_dir }}/chromadb-error.log

[Install]
WantedBy=multi-user.target
