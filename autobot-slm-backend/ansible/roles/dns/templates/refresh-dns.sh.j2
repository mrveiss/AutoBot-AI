# Refresh DNS configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

set -e

echo "🔄 Refreshing AutoBot DNS configuration..."

{% if install_dnsmasq %}
# Restart dnsmasq
echo "📋 Restarting dnsmasq..."
sudo systemctl restart dnsmasq
sudo systemctl status dnsmasq --no-pager -l
{% elif use_systemd_resolved %}
# Restart systemd-resolved
echo "📋 Restarting systemd-resolved..."
sudo systemctl restart systemd-resolved
sudo systemctl status systemd-resolved --no-pager -l
{% endif %}

# Flush DNS cache
echo "🧹 Flushing DNS cache..."
{% if install_dnsmasq %}
sudo pkill -HUP dnsmasq
{% elif use_systemd_resolved %}
sudo resolvectl flush-caches
{% else %}
# No cache to flush
echo "No DNS cache configured"
{% endif %}

# Test resolution
echo ""
echo "🧪 Testing DNS resolution..."
{{ autobot.base_dir }}/scripts/dns/test-dns-resolution.sh

echo ""
echo "✅ DNS configuration refreshed"
