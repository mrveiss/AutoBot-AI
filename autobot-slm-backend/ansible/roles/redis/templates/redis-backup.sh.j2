#!/bin/bash
# Redis Stack Backup Script for AutoBot
# Generated by Ansible - Redis Role
#
# WHITESPACE CONTRACT (#17932). Ansible's template module renders this with
# trim_blocks=True, which eats the newline that follows a Jinja block tag (no
# literal tag is spelled out in these comments - it would itself be rendered).
# A block tag at the end of a command line therefore FUSES that command with the
# next one, and the result is still valid-looking shell: the live fleet
# ran `tar ... appendonly-$TIMESTAMP.aofrm -f ...` nightly for 125 days, aborted
# on `set -e`, and logged a success line first.
#
# The remedy is structural, not another newline: this template contains NO block
# tags at all. Every conditional is decided in shell at run time, and the only
# Jinja left is plain expression substitution, which no whitespace setting can
# move. `redis_backup_template_renders_runnable_17932_test.py` renders this file
# with and without trim_blocks and requires the two results to be identical.

set -euo pipefail

BACKUP_DIR="/var/backups/redis"
# Hardcoded rather than substituting the role's `redis_data_dir`, whose default
# is /var/lib/redis while redis-stack.conf.j2 pins `dir /var/lib/redis-stack`.
# Substituting it would point this script at an empty directory.
REDIS_DATA_DIR="/var/lib/redis-stack"
REDIS_PORT={{ redis_port }}
RETENTION_DAYS={{ redis_backup_retention_days }}
REDIS_PERSISTENCE={{ 'yes' if redis_persistence else 'no' }}
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
ARCHIVE="redis-backup-$TIMESTAMP.tar.gz"
# Env-var-backed constant rather than a role variable: a `*timeout*: 300` in
# roles/redis/vars/main.yml is blocked by the hardcoded-value hook, whose remedy
# (`config.timeout.* from ssot_config`) is a Python concept with no Ansible
# counterpart, and whose baseline may not be grown from a file this change edits.
# The override point is kept where an operator can reach it on the host.
BGSAVE_TIMEOUT_SECONDS="${REDIS_BACKUP_BGSAVE_TIMEOUT_SECONDS:-300}"

# CLIENT CREDENTIAL (#17932 review). `redis-stack.conf.j2` emits a `requirepass`
# directive from the role's own password variable whenever one is set (no literal
# tag is spelled out here - see the whitespace contract at the top), so an
# auth-enabled host is a rendered configuration of this very role, and these
# three calls used to send no credential at all: no password, no username, no
# environment variable. The role's own readiness probe in
# roles/redis/tasks/main.yml sends the username plus the client password; this
# mirrors it.
#
# The VALUE is not substituted into this script, and that is a ruling rather
# than a style choice. This file is deployed 0755 and is re-rendered on the
# code-only update path, where `redis_password` is unresolvable -- the
# "DELIBERATELY EXCLUDED" note in roles/redis/tasks/code_only.yml keeps every
# credential-bearing artifact off that path for exactly that reason. Only the
# PATH below is substituted; it is a role default, not a secret. The file it
# names is 0600 root, written on the provisioning path, and parsed rather than
# sourced so a credential is never executed.
REDIS_BACKUP_ENV_FILE="{{ redis_backup_env_file }}"
REDIS_USERNAME=""
if [ -r "$REDIS_BACKUP_ENV_FILE" ]; then
    REDISCLI_AUTH="$(sed -n 's/^REDISCLI_AUTH=//p' "$REDIS_BACKUP_ENV_FILE" | head -n 1)"
    REDIS_USERNAME="$(sed -n 's/^REDIS_USERNAME=//p' "$REDIS_BACKUP_ENV_FILE" | head -n 1)"
fi

# redis-cli reads REDISCLI_AUTH from the environment, so the credential never
# reaches the process list the way `-a` would. Exported only when non-empty: a
# blank-but-set REDISCLI_AUTH makes redis-cli send an empty AUTH, which a nopass
# server rejects -- so the empty case must leave the variable unset, not blank.
REDIS_CLI_ARGS=(-h 127.0.0.1 -p "$REDIS_PORT")
if [ -n "${REDIS_USERNAME:-}" ]; then
    REDIS_CLI_ARGS+=(--user "$REDIS_USERNAME")
fi
if [ -n "${REDISCLI_AUTH:-}" ]; then
    export REDISCLI_AUTH
else
    unset REDISCLI_AUTH
fi

# AN ERROR REPLY IS NOT A MEASUREMENT (#17932 review). Without `-e`, redis-cli
# prints the server's error text to stdout and still exits 0, so an
# unauthenticated LASTSAVE yields the literal string "NOAUTH Authentication
# required." -- which the wait loop below then compares against itself forever,
# spinning to the timeout or archiving a stale dump.rdb. That is the same
# "reports success while producing no usable archive" failure this script was
# rewritten to end, so the reply is validated by SHAPE: a LASTSAVE that is not a
# bare integer is an error, whatever the server meant by it.
#
# Shape rather than `-e`: the flag exists in current redis-cli, but the fleet's
# redis-cli version could not be established from this repository, and a
# shape check is version-independent AND strictly broader -- it also catches a
# zero-exit reply that simply is not a timestamp.
redis_lastsave() {
    local reply
    reply="$(redis-cli "${REDIS_CLI_ARGS[@]}" LASTSAVE)"
    case "$reply" in
        '' | *[!0-9]*)
            echo "[$(date)] ERROR: LASTSAVE did not return a timestamp: ${reply}" >&2
            return 1
            ;;
    esac
    printf '%s\n' "$reply"
}

# A FAILING BACKUP MUST BE LOUD (#17932). The first line this script logs is a
# success line, so an abort anywhere after it reads as a successful backup
# followed by noise. BACKUP_COMPLETE is set on the last reachable statement and
# nowhere else, so the exit trap can tell completion from abort and always
# leaves a non-zero status plus a final FAILED line for cron to report.
BACKUP_COMPLETE=0
on_exit() {
    local rc=$?
    if [ "$rc" -eq 0 ] && [ "$BACKUP_COMPLETE" -eq 1 ]; then
        return 0
    fi
    if [ "$rc" -eq 0 ]; then
        rc=1
    fi
    echo "[$(date)] ERROR: Redis Stack backup FAILED (exit $rc) - no archive was produced" >&2
    exit "$rc"
}
trap on_exit EXIT

echo "[$(date)] Starting Redis Stack backup..."

# Create backup directory if it doesn't exist
mkdir -p "$BACKUP_DIR"

# Trigger Redis save - connect to localhost since this script runs on the Redis host.
# Completion is detected by LASTSAVE advancing past its pre-BGSAVE value. The previous
# loop compared LASTSAVE to `date +%s` and so exited on its first iteration, leaving a
# fixed 5s sleep as the only real wait and allowing a stale dump.rdb into the archive.
LAST_SAVE_BEFORE="$(redis_lastsave)"
# The BGSAVE reply is logged, not gated on. Redis answers "Background saving
# started", "Background saving scheduled" or the error "Background save already
# in progress" -- the last of which means a save IS running, so rejecting it
# would abort a run that is about to succeed. The LASTSAVE loop below is the
# gate, and it now refuses a non-timestamp, so an unauthenticated call fails at
# the line above rather than reaching here.
BGSAVE_REPLY="$(redis-cli "${REDIS_CLI_ARGS[@]}" BGSAVE)"
echo "[$(date)] BGSAVE requested: ${BGSAVE_REPLY}"
#
# The poll is an explicit assignment, not a command substitution inside the
# `while` condition: a condition is one of the contexts where `set -e` does not
# abort, so a LASTSAVE that starts failing mid-wait would be re-reported every
# two seconds until the timeout instead of ending the run at once.
WAITED_SECONDS=0
while true; do
    LAST_SAVE_NOW="$(redis_lastsave)"
    if [ "$LAST_SAVE_NOW" != "$LAST_SAVE_BEFORE" ]; then
        break
    fi
    if [ "$WAITED_SECONDS" -ge "$BGSAVE_TIMEOUT_SECONDS" ]; then
        echo "[$(date)] ERROR: BGSAVE did not complete within ${BGSAVE_TIMEOUT_SECONDS}s (BGSAVE replied: ${BGSAVE_REPLY})" >&2
        exit 1
    fi
    echo "Waiting for BGSAVE to complete..."
    sleep 2
    WAITED_SECONDS=$((WAITED_SECONDS + 2))
done

# What goes into the archive, collected as a shell array so the tar and rm lines
# below carry no Jinja tag. See the whitespace contract at the top of this file.
BACKUP_ITEMS=()

# Copy dump file
if [ -f "$REDIS_DATA_DIR/dump.rdb" ]; then
    cp "$REDIS_DATA_DIR/dump.rdb" "$BACKUP_DIR/dump-$TIMESTAMP.rdb"
    BACKUP_ITEMS+=("dump-$TIMESTAMP.rdb")
    echo "[$(date)] Backup created: dump-$TIMESTAMP.rdb"
else
    echo "[$(date)] ERROR: dump.rdb not found" >&2
    exit 1
fi

# Copy AOF data if persistence is enabled.
#
# Redis 7 keeps the append-only data in a DIRECTORY - `appenddirname` defaults to
# `appendonlydir` - holding a manifest plus the base and incr files. Redis 6 and
# earlier keep a single `appendonly.aof` at the data root. This script only ever
# tested for the pre-7 file, which cannot exist on this fleet, so no AOF had ever
# been archived despite `appendonly yes` (#17932). Both layouts are handled.
#
# Finding neither while persistence is on does NOT abort: aborting would discard
# the RDB copy as well, which is strictly worse than an RDB-only archive. It is
# instead carried into the final log line, because a warning in the middle of a
# log is the silence this issue is about.
AOF_STATUS=disabled
if [ "$REDIS_PERSISTENCE" = "yes" ]; then
    AOF_STATUS=missing
    if [ -d "$REDIS_DATA_DIR/appendonlydir" ]; then
        cp -a "$REDIS_DATA_DIR/appendonlydir" "$BACKUP_DIR/appendonlydir-$TIMESTAMP"
        BACKUP_ITEMS+=("appendonlydir-$TIMESTAMP")
        AOF_STATUS=appendonlydir
        echo "[$(date)] AOF backup created: appendonlydir-$TIMESTAMP"
    elif [ -f "$REDIS_DATA_DIR/appendonly.aof" ]; then
        cp "$REDIS_DATA_DIR/appendonly.aof" "$BACKUP_DIR/appendonly-$TIMESTAMP.aof"
        BACKUP_ITEMS+=("appendonly-$TIMESTAMP.aof")
        AOF_STATUS=appendonly.aof
        echo "[$(date)] AOF backup created: appendonly-$TIMESTAMP.aof"
    else
        echo "[$(date)] WARNING: persistence is enabled but no AOF was found under $REDIS_DATA_DIR" >&2
    fi
fi

# Compress backups
cd "$BACKUP_DIR"
tar -czf "$ARCHIVE" "${BACKUP_ITEMS[@]}"
rm -rf -- "${BACKUP_ITEMS[@]}"

# The archive is the only thing this script exists to produce, so its existence is
# checked rather than assumed - `tar` has already once "succeeded" into no file.
if [ ! -s "$ARCHIVE" ]; then
    echo "[$(date)] ERROR: archive $ARCHIVE was not produced" >&2
    exit 1
fi
echo "[$(date)] Backup compressed: $ARCHIVE"

# Cleanup old backups. Scoped to this script's own archives; the orphaned
# dump-*.rdb left behind by the years of aborted runs are data and are not swept
# here - that disposition needs an owner decision, not a script (#17932).
find "$BACKUP_DIR" -name "redis-backup-*.tar.gz" -mtime +"$RETENTION_DAYS" -delete
echo "[$(date)] Old backups cleaned up (retention: $RETENTION_DAYS days)"

# The last line of the log is where "did the backup run" is actually answered, so
# it carries the verdict AND what the archive holds. Its counterpart on any other
# path is the trap's FAILED line; there is no third ending.
BACKUP_COMPLETE=1
echo "[$(date)] Redis Stack backup complete: $ARCHIVE (rdb=yes aof=$AOF_STATUS)"
