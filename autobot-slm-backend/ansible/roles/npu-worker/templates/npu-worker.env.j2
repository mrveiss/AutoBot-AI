# NPU Worker Environment

# Server
NPU_HOST={{ npu_host }}
NPU_PORT={{ npu_port }}

# Device
NPU_DEVICE={{ npu_device }}
NPU_MODELS_DIR={{ npu_models_dir }}

# Redis
REDIS_HOST={{ npu_redis_host }}
REDIS_PORT={{ npu_redis_port }}
{% if npu_redis_password | length > 0 %}
REDIS_PASSWORD={{ npu_redis_password }}
{% endif %}

# Log directory (#20894): without it the resolver falls back to the XDG state dir
# Ansible-managed nodes log to the shared /var/log/autobot (#12425: the role creates it with the shared
# ownership and the unit's StandardOutput appends there); the static units under autobot-infrastructure/
# are the non-ansible path and log to <WorkingDirectory>/logs. Override npu_log_dir to move this node.
AUTOBOT_LOGS_DIR={{ npu_log_dir }}
