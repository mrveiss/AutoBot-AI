# NPU Worker Environment

# Server
NPU_HOST={{ npu_host }}
NPU_PORT={{ npu_port }}

# Device
NPU_DEVICE={{ npu_device }}
NPU_MODELS_DIR={{ npu_models_dir }}

# Redis
REDIS_HOST={{ npu_redis_host }}
REDIS_PORT={{ npu_redis_port }}
{% if npu_redis_password | length > 0 %}
REDIS_PASSWORD={{ npu_redis_password }}
{% endif %}

# Log directory (#20894): without it the resolver falls back to the XDG state dir. This is the application's
# directory (npu_app_log_dir), not the unit's service-output directory (npu_log_dir); see the role defaults.
AUTOBOT_LOGS_DIR={{ npu_app_log_dir }}
