# AutoBot SLM Nginx Configuration
# Managed by Ansible - slm_manager role

# WebSocket Upgrade/Connection map (http context).
# Sends "Connection: upgrade" only for real WS requests and "Connection: close"
# for plain REST GETs, so proxied HTTP/1.1 keepalive REST calls are not broken
# by a hardcoded upgrade header (#10378).
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# #16374: the session credential the log-stream WebSocket's own auth_request
# subrequest forwards (see location ~ ^/autobot-api/processes/.../stream$
# below). A native `new WebSocket()` handshake cannot set a custom
# Authorization header, so the frontend offers the SLM session token as a
# `Sec-WebSocket-Protocol` subprotocol instead (`new WebSocket(url,
# ['bearer', token])`), which browsers serialise onto the wire as
# `Sec-WebSocket-Protocol: bearer, <token>`. This never touches the request
# URL, so the token never lands in the access log or browser history — round
# 1 of #16374 carried it as ?slm_ws_token= instead, which did both.
map $http_sec_websocket_protocol $slm_stream_authorization {
    default               '';
    "~^bearer,\s*(\S+)$"  "Bearer $1";
}

{% if slm_colocated_frontend | default(false) | bool %}
# Co-located user backend upstream (#2829)
# Proxies directly to uvicorn (HTTP) — no intermediate backend nginx.
upstream autobot_backend {
    server {{ frontend_backend_host }}:{{ frontend_backend_port }};
}
{% endif %}

# Redirect HTTP to HTTPS
server {
    listen 80;
    listen [::]:80;
    server_name _;

    return 301 https://$host$request_uri;
}

# HTTPS server
server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name _;

    # SSL configuration
    ssl_certificate {{ slm_tls_cert }};
    ssl_certificate_key {{ slm_tls_key }};

    # SSL settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    # Security headers (#6842: DRY — single source of truth in snippet)
    include /etc/nginx/snippets/autobot-security-headers-strict.conf;

    # Issue #1090: Allow SLM agent event sync payloads (typically 1.5-2MB)
    client_max_body_size 10m;

    # Logging
    access_log {{ slm_log_dir }}/nginx-access.log;
    error_log {{ slm_log_dir }}/nginx-error.log;

    # Frontend static files.
    # #15610: `current` is a symlink the publish flips with a single rename(2)
    # (roles/_shared/tasks/build_publish_slm_frontend.yml). It replaced `dist`,
    # a directory that was renamed twice per publish and therefore did not
    # exist between the two renames. nginx resolves root/alias per request and
    # follows symlinks — there is no open_file_cache and no disable_symlinks in
    # this config — so a flip is served to the next request without a reload.
    root {{ slm_frontend_dir }}/current;
    index index.html;

{% if slm_colocated_frontend | default(false) | bool %}
    # ── Co-located mode (#2829) ───────────────────────────────
    # SLM API under /slm/api/, user backend at /api/, user frontend at /
    # Backend upstream is plain HTTP to uvicorn — no double-proxy.

    # SLM Backend WebSocket (must be before /slm/api/ to take priority)
    location /slm/api/ws/ {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # SLM Backend API reverse proxy
    # #13604: upgrade headers here so a new SLM WebSocket route works without
    # its own location block. $connection_upgrade is "close" for plain HTTP.
    location /slm/api/ {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # SLM Backend health check
    location /slm/api/health {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # Issue #3105: WebSocket proxy for /api/ws/ — must be BEFORE /api/ to take priority
    location /api/ws/ {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
    }

    # User backend WebSocket proxies (HTTP to uvicorn)
    # Issue #3108: include X-Forwarded-* proxy headers
    location /api/ws {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
    }

    location /api/terminal/ws {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 300s;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
    }

    location /api/voice/stream {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
    }

    location /ws {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
    }

    # Issue #10750 A9: WebSocket proxy for workflow-automation — must be BEFORE /api/ to take priority.
    # Without this block the WS handshake falls through to /api/ which strips the Upgrade
    # header, causing FastAPI's WebSocket route to receive a plain HTTP GET and return 404.
    location /api/workflow-automation/workflow_ws {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
    }

    # User backend API proxy
    #
    # #13604: the upgrade headers are what make a new WebSocket route work
    # without its own block above. $connection_upgrade is "close" for plain HTTP,
    # so REST is unaffected. An upgraded request matching here inherits
    # proxy_read_timeout 300s rather than the 86400 the dedicated blocks use —
    # proxy_read_timeout takes no variables, so a route needing a longer idle
    # window still adds its own block, but now degrades to a reconnect, not 404.
    location /api/ {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        # #10565: the server-level 10m cap (sized for SLM agent sync) rejected
        # transcriber/knowledge media uploads (audio/video — .mp4/.m4a/.wav etc.)
        # with 413. User-backend uploads need a generous cap; the app enforces its
        # own per-file limit. Scoped here so SLM agent paths keep the 10m default.
        client_max_body_size 1g;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # FastAPI OpenAPI docs (#6749 follow-up — without these, the SPA fallback
    # serves index.html for /openapi.json /docs /redoc instead of the spec).
    # Use `=` for /openapi.json (exact match) so it can't shadow real routes;
    # `^~` for /docs and /redoc so prefix match takes priority over the SPA
    # catch-all.
    location = /openapi.json {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
    }
    location ^~ /docs {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
    }
    location ^~ /redoc {
        proxy_pass {{ frontend_backend_protocol }}://autobot_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if frontend_backend_protocol == 'https' %}
        proxy_ssl_verify off;
{% endif %}
    }

{% else %}
    # ── Standalone mode ───────────────────────────────────────
    # SLM API at both /api/ and /slm/api/ (#3268: agents always use /slm/api/)

    # WebSocket endpoint (must be before /api/ to take priority)
    location /api/ws/ {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # /slm/api/ alias — agents always use this path regardless of mode (#3268)
    location /slm/api/ws/ {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/ws/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 86400;
    }

    # #13604: upgrade headers on the generic blocks — see the equivalents in the
    # first server block above for the rationale and the timeout caveat.
    location /slm/api/ {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # API reverse proxy
    location /api/ {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Health check endpoint (bypass auth)
    location /api/health {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/health;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
    }

    # FastAPI OpenAPI docs (#6843 — without these, the SPA fallback serves
    # index.html for /openapi.json /docs /redoc instead of the spec).
    # Use `=` for /openapi.json (exact match) so it can't shadow real routes;
    # `^~` for /docs and /redoc so prefix match takes priority over the SPA
    # catch-all.
    location = /openapi.json {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /docs {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
    location ^~ /redoc {
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

{% endif %}

    # Grafana Live WebSocket (must be before the general /grafana/ block)
    location /grafana/api/live/ {
        proxy_pass http://{{ grafana_host }}:{{ grafana_port }}/grafana/api/live/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600;

        # #6842: DRY — headers in snippet; frame-ancestors 'self' allows dashboard embedding.
        include /etc/nginx/snippets/autobot-security-headers-iframe-host.conf;
    }

    # Grafana reverse proxy (monitoring dashboards)
    # Issue #853: Support both local and external Grafana instances
    location /grafana/ {
        proxy_pass http://{{ grafana_host }}:{{ grafana_port }}/grafana/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # #6842: DRY — headers in snippet; frame-ancestors 'self' allows dashboard embedding.
        include /etc/nginx/snippets/autobot-security-headers-iframe-host.conf;
{% if grafana_enable_cors | default(false) %}

        # CORS headers for external Grafana iframe embedding
        add_header Access-Control-Allow-Origin "{{ grafana_cors_origin }}" always;
        add_header Access-Control-Allow-Credentials "true" always;
{% endif %}
    }

    # Prometheus reverse proxy (metrics queries)
    location /prometheus/ {
        proxy_pass http://{{ prometheus_host }}:{{ prometheus_port }}/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # #16374 round 3: session gate for the internal-key injection in
    # /autobot-api/ below. auth_request fires this as a subrequest BEFORE
    # nginx adds X-Internal-API-Key, reusing the SLM backend's own
    # admin-role dependency (services/auth.py require_admin, via
    # GET /api/auth/proxy-check) so only a caller holding a live *admin* SLM
    # session reaches the backend through this path. Round 2 pointed this at
    # GET /api/auth/me, which only checks that the session is valid — every
    # backend login token is a valid SLM session by design (epic #10193), so
    # a read-only or non-admin user's own token passed the gate and nginx
    # attached the admin-equivalent internal key on their behalf. Every REST
    # call through /autobot-api/ sends its own Authorization header —
    # nothing here falls back to the query string.
    location = /_slm_session_check {
        internal;
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/auth/proxy-check;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Authorization $http_authorization;
    }

    # #16374 round 2/3: the same admin-session gate as /_slm_session_check
    # above, but for the process-log WebSocket (location ~
    # ^/autobot-api/processes/.../stream$ below), which offers its session
    # token as a Sec-WebSocket-Protocol subprotocol rather than an
    # Authorization header — a browser WebSocket handshake cannot set a
    # custom header. $slm_stream_authorization (mapped above) is that
    # subprotocol, reshaped into the same "Bearer <token>" form
    # require_admin/get_current_user expect.
    location = /_slm_stream_session_check {
        internal;
        proxy_pass http://{{ slm_backend_host }}:{{ slm_backend_port }}/api/auth/proxy-check;
        proxy_http_version 1.1;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Host $host;
        proxy_set_header X-Original-URI $request_uri;
        proxy_set_header Authorization $slm_stream_authorization;
    }

    # #16374 round 2: the process-log WebSocket gets its own location, ahead
    # of the general /autobot-api/ one below, so its auth_request can read
    # the session credential from Sec-WebSocket-Protocol instead of
    # requiring the Authorization header no browser WebSocket handshake can
    # send. A regex location always wins over a plain-prefix one (here,
    # /autobot-api/), so this needs no ^~ and no reordering of that block.
    # $stream_process_id captures the process id into an ordinary request
    # variable up front, rather than leaning on the regex capture ($1)
    # surviving the auth_request subrequest below -- proxy_pass rebuilds the
    # exact backend path the /autobot-api/ prefix strip would have produced.
    location ~ ^/autobot-api/processes/([^/]+)/stream$ {
        set $stream_process_id $1;
        auth_request /_slm_stream_session_check;

{% if slm_colocated_frontend | default(false) | bool %}
        proxy_pass http://autobot_backend/api/processes/$stream_process_id/stream;
{% else %}
        proxy_pass {{ autobot_backend_protocol | default('http') }}://{{ autobot_backend_host }}:{{ autobot_backend_port }}/api/processes/$stream_process_id/stream;
{% if (autobot_backend_protocol | default('http')) == 'https' %}
        proxy_ssl_verify off;
{% endif %}
{% endif %}
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if autobot_internal_api_key %}
        proxy_set_header X-Internal-API-Key "{{ autobot_internal_api_key }}";
{% endif %}
        # #16374 round 2: the backend only needs to know the client offered
        # "bearer" so its own accept() can echo a subprotocol back (RFC 6455
        # 4.2.2 fails the handshake otherwise) — the token itself never
        # reaches it.
        proxy_set_header Sec-WebSocket-Protocol "bearer";
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # Main AutoBot backend proxy (user backend skills, cache, etc.)
    # /autobot-api/* → http://main_backend/api/* (strips /autobot-api prefix) (#10378)
    # Issue #1791: inject X-Internal-API-Key for service auth + WebSocket support
    location /autobot-api/ {
        # #16374: a failed session check returns nginx's own 401/403 to the
        # client here — ngx_http_auth_request_module never lets a request
        # past this line reach proxy_pass below on anything but 2xx. The
        # process-log WebSocket is carved out into its own location above;
        # everything landing here sends a real Authorization header.
        auth_request /_slm_session_check;

        # #10378: main backend is plain HTTP on its real port. Co-located deploys
        # use the autobot_backend upstream (uvicorn :8001); standalone proxies to
        # the inventory backend host/port over its configured protocol.
{% if slm_colocated_frontend | default(false) | bool %}
        proxy_pass http://autobot_backend/api/;
{% else %}
        proxy_pass {{ autobot_backend_protocol | default('http') }}://{{ autobot_backend_host }}:{{ autobot_backend_port }}/api/;
{% if (autobot_backend_protocol | default('http')) == 'https' %}
        proxy_ssl_verify off;
{% endif %}
{% endif %}
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
{% if autobot_internal_api_key %}
        proxy_set_header X-Internal-API-Key "{{ autobot_internal_api_key }}";
{% endif %}
        # WebSocket support (#1777). Use the $connection_upgrade map so plain
        # REST GETs are not forced to upgrade.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_connect_timeout 60s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }

    # noVNC WebSocket/HTTP proxy — Issue #1002
    # /tools/novnc/* → http://main_backend:6080/* (strips /tools/novnc prefix)
    # Needed to avoid mixed-content blocking when embedding VNC in HTTPS SLM admin.
    location /tools/novnc/ {
        proxy_pass http://{{ autobot_backend_host }}:{{ novnc_port }}/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 3600;
    }

    # SLM Frontend SPA at /slm/ subroute (#2716)
    location = /slm {
        return 301 /slm/;
    }

    location /slm/ {
        # #15610: the atomically-flipped pointer, not a renamed directory.
        alias {{ slm_frontend_dir }}/current/;
        try_files $uri $uri/ /slm/index.html;

        # Prevent index.html from being cached so new deployments are picked up
        # #7737: child location replaces server-level add_header — re-include snippet
        location ~* /slm/index\.html$ {
            include /etc/nginx/snippets/autobot-security-headers-strict.conf;
            add_header Cache-Control "no-cache, no-store, must-revalidate" always;
            add_header Pragma "no-cache" always;
        }
    }

{% if slm_colocated_frontend | default(false) | bool %}
    # User frontend SPA fallback — serves index.html for client-side routes
    location / {
        root {{ frontend_dist_dir }};
        try_files $uri $uri/ /index.html;

        # #6842: include strict security headers (nginx add_header in location replaces server-level)
        include /etc/nginx/snippets/autobot-security-headers-strict.conf;
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        add_header Pragma "no-cache";
        add_header Cross-Origin-Opener-Policy "same-origin" always;
        add_header Cross-Origin-Embedder-Policy "credentialless" always;
    }
{% else %}
    # Standalone SLM: redirect root to /slm/
    location = / {
        return 302 /slm/;
    }
{% endif %}

    # Gzip compression
    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;
    gzip_min_length 1000;
}
