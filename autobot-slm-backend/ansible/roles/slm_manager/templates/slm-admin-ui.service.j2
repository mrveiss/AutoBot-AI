[Unit]
Description=AutoBot SLM Admin UI - Frontend Health Monitor
Documentation=https://github.com/mrveiss/AutoBot-AI
After=nginx.service
Requires=nginx.service
PartOf=nginx.service

[Service]
Type=oneshot
# #7054: autobot owns the cert (0600 autobot:autobot) so it can read --cacert;
# this service is a one-shot probe and doesn't need root capability.
User=autobot
Group=autobot

# Health check: verify SLM frontend is built and nginx can serve it.
# --cacert pins the self-signed cert installed at TLS bootstrap (#7024).
# #15610: `current` is the path nginx serves — a symlink the publish flips onto
# a per-build directory. It replaced `dist`, which on a node provisioned after
# this change never exists, so the probe would have failed permanently while
# nginx served the UI correctly. Rendered from slm_frontend_dir rather than a
# literal, so the install location is written down once.
ExecStart=/bin/sh -c 'test -f {{ slm_frontend_dir }}/current/index.html && curl -sf --cacert {{ slm_tls_cert }} https://127.0.0.1/slm/ > /dev/null'

# Mark service as successful if health check passes
RemainAfterExit=yes

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=slm-admin-ui

[Install]
WantedBy=multi-user.target
