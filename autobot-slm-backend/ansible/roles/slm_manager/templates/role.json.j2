{
  "role": "slm-server",
  "version": "{{ slm_version | default(git_commit) | default('unknown') }}",
  "deploy_path": "{{ slm_backend_dir }}",
  "service": "autobot-slm-backend",
  "ansible_playbook": "deploy-slm-manager.yml",
  "build_steps": [
    "pip install -r requirements.txt",
    "npm install && npm run build:slm into a fresh dist-<id>/, verified for a real index.html, then published by atomically flipping the served `current` symlink to it (roles/_shared/tasks/build_publish_slm_frontend.yml, #15557/#15610) — not a flat build-in-place"
  ],
  "depends_on": [],
  "required": true,
  "degraded_without": [],
  "deployed_at": "{{ ansible_facts['date_time'].iso8601 }}"
}
