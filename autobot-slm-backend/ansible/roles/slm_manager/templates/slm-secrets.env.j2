# SLM Backend Security Secrets
# Generated by Ansible - Do not edit manually
# This file is loaded by systemd EnvironmentFile=

SLM_SECRET_KEY={{ slm_secret_key }}
SLM_ENCRYPTION_KEY={{ slm_encryption_key }}
SLM_ADMIN_PASSWORD={{ slm_admin_password }}
# Bearer token for autobot-backend → SLM WebSocket authentication (#7689)
SLM_AUTH_TOKEN={{ slm_auth_token }}

# Internal API key shared with main backend for proxy authentication (#1779)
# Must be set to a non-empty secret in inventory/vault; defaults to "" (disabled)
AUTOBOT_INTERNAL_API_KEY={{ autobot_internal_api_key }}

# #12513: shared secret for chroma's CHROMA_SERVER_AUTHN_* token auth. Read back
# from here by the chroma unit (redis / ai-stack roles) and by the backend's env
# template, so server and client always carry the same value. Generated once and
# kept forever — rotating it requires restarting chroma and every client together.
AUTOBOT_CHROMADB_AUTH_TOKEN={{ chromadb_auth_token }}

# #14758: root key for the canonical envelope secret store. The backend reads it
# back from this file so both services derive the same vault keys — the SLM's SSO
# vault migration explicitly requires the backend's root key, not its own.
# Generated once and kept forever: rotating it makes every secret already sealed
# under it undecryptable.
AUTOBOT_SECRETS_ROOT_KEY={{ autobot_secrets_root_key }}

# #16627 (P1b of #13568): the Redis credential every consumer sends, read back from
# here by the roles and by the SLM itself (this is its EnvironmentFile). The server
# stays nopass until P2 (#16628) and accepts AUTH default <password>, but refuses a
# password sent without a username -- so the two lines always travel together.
# Generated once and kept forever.
AUTOBOT_REDIS_USERNAME={{ slm_redis_username }}
AUTOBOT_REDIS_PASSWORD={{ slm_redis_password }}

# #16299: backend's SECRET_KEY. Read back by the backend role (#10400's
# SLM_SECRET_KEY pattern) since backend commonly runs on a different host.
# Generated once and kept forever.
AUTOBOT_BACKEND_SECRET_KEY={{ backend_secret_key }}

# #16299: Grafana's admin password. Read back by the monitoring role the same
# way. Generated once and kept forever -- rotating it here does not rotate it
# in Grafana's own database; see grafana.ini's admin_password semantics.
GRAFANA_ADMIN_PASSWORD={{ grafana_admin_password }}

# Override /opt/autobot/.env which has 0.0.0.0 (backend bind addr, not target)
# SLM must connect to the backend at its actual IP (#915)
AUTOBOT_BACKEND_HOST={{ main_host | default(infrastructure.hosts.backend if infrastructure is defined else '127.0.0.1') }}

# Issue #2758: set external_url to this node's actual routable IP so that
# self-detection logic (e.g. _is_local_node) works correctly.
# ansible_facts['default_ipv4'].address is the primary non-loopback interface IP.
SLM_EXTERNAL_URL=https://{{ ansible_facts['default_ipv4'].address | default(ansible_host) }}
