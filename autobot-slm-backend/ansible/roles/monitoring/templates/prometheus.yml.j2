# Prometheus Configuration - Generated by Ansible
---

global:
  scrape_interval: {{ prometheus_scrape_interval }}
  evaluation_interval: {{ prometheus_evaluation_interval }}

alerting:
  alertmanagers: []

rule_files: []

scrape_configs:
  # Prometheus self-monitoring
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:{{ prometheus_port }}"]

  # SLM Backend DB-derived metrics (SystemMetrics text exposition)
  - job_name: "slm"
    static_configs:
      - targets: ["localhost:8000"]
    metrics_path: /api/performance/metrics/prometheus
    scheme: http

  # SLM Backend shared-registry app metrics (#10851 top-level /metrics; #10858)
  # Exposes autobot_llm_requests_total / autobot_knowledge_search_requests_total
  # / autobot_api_requests_total for the BI dashboard real-source queries
  # (#10720/#10778). Unauthenticated per health-probe convention; plain http on
  # the uvicorn backend port (8000), not the nginx TLS front.
  - job_name: "slm-backend"
    static_configs:
      - targets: ["localhost:8000"]
    metrics_path: /metrics
    scheme: http

  # Node exporters on all managed fleet nodes (auto-populated from inventory)
  - job_name: "node"
    static_configs:
      - targets:
{% for host in groups.get('slm_nodes', []) %}
          - "{{ hostvars[host]['ansible_host'] }}:{{ node_exporter_port }}"
{% endfor %}
{% if groups.get('slm_nodes', []) | length == 0 %}
          - "localhost:{{ node_exporter_port }}"
{% endif %}

  # AutoBot backend metrics (HTTPS with self-signed cert, issue #944)
  - job_name: "autobot-backend"
    static_configs:
      - targets: ["{{ backend_host | default(infrastructure.hosts.backend if infrastructure is defined else '127.0.0.1') }}:8443"]
    metrics_path: /api/metrics/prometheus
    scheme: https
    tls_config:
      insecure_skip_verify: true

  # Redis exporter (if available)
  - job_name: "redis"
    static_configs:
      - targets: ["{{ redis_host | default(infrastructure.hosts.database if infrastructure is defined else '127.0.0.1') }}:9121"]
    scheme: http
