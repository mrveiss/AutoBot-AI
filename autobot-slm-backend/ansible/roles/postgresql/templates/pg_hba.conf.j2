# PostgreSQL Client Authentication Configuration
# Generated by Ansible - Do not edit manually
#
# Renders local/host auth for every app user that shares this instance.
# Multi-VM: postgresql_app_users defaults to [db_user] (one user per
# instance — unchanged). Single-box collapse: pass the full list (e.g.
# [slm_app, autobot_app]) so provisioning one user never drops the others
# from pg_hba (#10636).
{% set _app_users = postgresql_app_users | default([db_user]) %}

# TYPE  DATABASE        USER            ADDRESS                 METHOD

# Local connections
local   all             postgres                                peer
{% for _u in _app_users %}
local   all             {{ _u }}                           scram-sha-256
{% endfor %}

# IPv4 local connections
{% for _u in _app_users %}
host    all             {{ _u }}   127.0.0.1/32            scram-sha-256
{% endfor %}

# IPv6 local connections
{% for _u in _app_users %}
host    all             {{ _u }}   ::1/128                 scram-sha-256
{% endfor %}

{% if pg_hba_remote_access is defined %}
# Remote connections (configured per-host)
{% for entry in pg_hba_remote_access %}
host    {{ entry.database }}    {{ entry.user }}    {{ entry.address }}    scram-sha-256
{% endfor %}
{% endif %}
