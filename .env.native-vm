# AutoBot Native VM Deployment Configuration
# OVERLAY on .env.base (#18555): load .env.base first; this file holds only what differs.
# Hand-maintained: generate-env-files.py is broken pending #18565 and, once repaired, writes
# overlay-only output (it strips keys that repeat .env.base).
# Configuration for distributed native VM architecture
# NOTE: Host IPs are set at deploy time — not stored in version control.

# Core Infrastructure - Distributed VMs — fill in your actual deployment IPs

# Service Ports

# Redis database numbers: redis-databases.yaml (#19232). Set AUTOBOT_REDIS_DB_<NAME> only
# where this deployment differs; a copy of the whole table here is a second source.

# Service URLs (Distributed) — constructed at deploy time from hosts above
AUTOBOT_BACKEND_URL=
AUTOBOT_FRONTEND_URL=
AUTOBOT_REDIS_URL=
AUTOBOT_OLLAMA_URL=
AUTOBOT_AI_STACK_URL=
AUTOBOT_NPU_WORKER_URL=
AUTOBOT_BROWSER_SERVICE_URL=

# WebSocket Configuration
AUTOBOT_WS_URL=

# Deployment Configuration
AUTOBOT_DEPLOYMENT_MODE=distributed
AUTOBOT_DEBUG=true
AUTOBOT_LOG_LEVEL=INFO
AUTOBOT_DOCKER_ENABLED=false
AUTOBOT_VM_ARCHITECTURE=true

# Performance Settings
AUTOBOT_API_TIMEOUT=10000
AUTOBOT_LLM_TIMEOUT=30

# Hardware Acceleration Compatibility
TF_USE_LEGACY_KERAS=1
KERAS_BACKEND=tensorflow

# Legacy Compatibility
OLLAMA_PORT=11434
