# AutoBot Frontend Service (Vue/Vite Dev Server)
# Dev-server unit. The backend address comes from the deployed env file, never from this file (#19828).
# Port: 5173

[Unit]
Description=AutoBot Frontend (Vue/Vite)
Documentation=https://github.com/mrveiss/AutoBot-AI
After=network.target
Wants=network-online.target
# #20620, #4090: a restarting unit must be able to reach `failed`. The window has to exceed
# RestartSec * StartLimitBurst, or the limit is never hit and the unit loops forever while
# showing `activating`. Same values as the role-rendered units.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=autobot
Group=autobot
WorkingDirectory=/home/autobot/autobot-vue
Environment=NODE_ENV=development
EnvironmentFile=-/etc/autobot/autobot-frontend.env
ExecStart=/snap/bin/npm run dev -- --host --port 5173
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autobot-frontend

# Allow home directory access for npm
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
