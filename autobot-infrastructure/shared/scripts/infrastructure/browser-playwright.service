[Unit]
Description=Playwright API Server for Browser VM (Headed Mode)
After=browser-vnc.service
Requires=browser-vnc.service
# #20620, #4090: a restarting unit must be able to reach `failed`. The window has to exceed
# RestartSec * StartLimitBurst, or the limit is never hit and the unit loops forever while
# showing `activating`. Same values as the role-rendered units.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=autobot
WorkingDirectory=/home/autobot
Environment="HEADLESS=false"
Environment="DISPLAY=:1"
Environment="NODE_ENV=production"
Environment="PLAYWRIGHT_PORT=9001"
ExecStart=/usr/bin/node /home/autobot/playwright-server.js
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
