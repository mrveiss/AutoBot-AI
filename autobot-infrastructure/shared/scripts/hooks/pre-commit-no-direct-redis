#!/bin/bash
# AutoBot - AI-Powered Automation Platform
# Copyright (c) 2025 mrveiss
# Author: mrveiss
#
# Pre-commit Hook: No New Direct Redis Clients
# ============================================
#
# Runs the ONE matcher (tools/lint/check_no_direct_redis.py) over the staged files, against the
# ONE baseline (repo_tests/redis_direct_constructor_baseline_18553.py) -- the same code the
# whole-tree ratchet (repo_tests/redis_direct_constructor_18553_test.py) runs. Blocks a direct
# `redis.Redis(` / `from_url` / `ConnectionPool` / `StrictRedis` / `Sentinel` / `RedisCluster` /
# `from_pool` construction that is not frozen in the baseline with a reason.
#
# Reads: .py and .sh under the guard's scan roots (autobot-infrastructure/ included), minus tests
# and autobot_shared/redis* (the canonical engine). There is no `# noqa: redis` opt-out: a site is
# in the baseline with a verdict, or it fails.
#
# Issue: #1086 (original hook), #18553 (one matcher, one baseline)
#
# Install: pre-commit install (uses .pre-commit-config.yaml)

set -euo pipefail

# Source shared library (#7185 — colors + get_staged_files)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/_common.sh
source "$SCRIPT_DIR/lib/_common.sh" || {
    echo "FATAL: cannot load lib/_common.sh — refusing to report clean" >&2
    exit 1
}

# The checkout this hook belongs to: hooks/ -> scripts/ -> shared/ -> autobot-infrastructure/ -> root.
# File paths stay relative to the invoking cwd (the repo being committed to); only the matcher and
# the baseline are imported from here.
TOOL_ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"

main() {
    echo -e "${BOLD}${CYAN}Pre-commit: No New Direct Redis Clients${NC}"
    echo "Issue #1086 / #18553 - Redis Client Standard Enforcement"
    echo "================================================"

    # get_staged_files' own git failure propagates (GH#14151); `|| true` only tolerates "no match".
    # Positional args override the staged lookup (#6785: same hook as local pre-commit AND CI gate).
    local files
    files="$(get_staged_files '\.(py|sh)$' "$@")" || return 1

    if [[ -z "$files" ]]; then
        echo -e "${GREEN}No Python or shell files staged for commit.${NC}"
        return 0
    fi

    local status=0
    # shellcheck disable=SC2086  # one path per line, no spaces in tracked source paths
    PYTHONPATH="$TOOL_ROOT${PYTHONPATH:+:$PYTHONPATH}" python3 -m tools.lint.check_no_direct_redis $files || status=$?

    echo "================================================"
    if [[ $status -ne 0 ]]; then
        echo -e "${RED}COMMIT BLOCKED: direct Redis client(s) outside the baseline${NC}"
        echo ""
        echo "Quick fix:"
        echo "  from autobot_shared.redis_client import get_redis_client"
        echo "  redis_client = get_redis_client(async_client=False, database=\"main\")"
        echo "  # bytes wanted: get_redis_client(database=\"temp\", decode_responses=False)"
        return 1
    fi
    echo -e "${GREEN}No direct Redis client violations found!${NC}"
}

main "$@"
