#!/bin/bash
# AutoBot - AI-Powered Automation Platform
# Copyright (c) 2025 mrveiss
# Author: mrveiss
#
# Pre-commit Hook: Detect Mass File Deletions
# =====================================================
#
# Prevents catastrophic commit accidents by detecting when a large number
# of files are staged for deletion (>50), which usually indicates a bug
# in stash handling or worktree interaction rather than intentional cleanup.
#
# Issue: #4111 - 5371 files staged for deletion in issue-4036 worktree
# Related: #1654 - pre-commit stash pop can switch active branch
# Related: #1503 - pre-commit stash/restore can stage untracked files
#
# This hook catches mass deletions BEFORE they're committed, allowing the
# developer to either:
#   1. Verify the deletion is intentional with `--no-verify`
#   2. Unstage the files with `git reset`
#   3. Investigate the root cause

set -uo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/_common.sh
source "$SCRIPT_DIR/lib/_common.sh"

# Threshold: alert if >50 files are staged for deletion
# (anything >50 is almost certainly a stash bug, not intended cleanup)
DELETION_THRESHOLD=50

main() {
    # Count files staged for deletion (git ls-files --deleted)
    deletion_count=$(git diff --cached --name-only --diff-filter=D | wc -l)

    if [ "$deletion_count" -le "$DELETION_THRESHOLD" ]; then
        # Normal deletion count — allow the commit
        exit 0
    fi

    # Mass deletion detected — abort and show details
    echo ""
    echo -e "${BOLD}${RED}BLOCKED: Mass file deletion detected (Issue #4111)${NC}"
    echo -e "${CYAN}──────────────────────────────────────────────────────────────${NC}"
    echo ""
    echo -e "  Staged deletions: ${BOLD}${deletion_count}${NC} files"
    echo -e "  Threshold:        ${DELETION_THRESHOLD} files (safety limit)"
    echo ""
    echo "  This is likely a stash-handling bug, not intentional cleanup."
    echo "  Check:"
    echo "    1. Are other worktrees using the same branch?"
    echo "    2. Did pre-commit stash/pop interact with another worktree?"
    echo "    3. Did a branch switch occur silently during stash?"
    echo ""
    echo -e "  ${YELLOW}First 20 files staged for deletion:${NC}"
    git diff --cached --name-only --diff-filter=D | head -20 | sed 's/^/    /'
    if [ "$deletion_count" -gt 20 ]; then
        echo "    ... and $((deletion_count - 20)) more"
    fi
    echo ""
    echo -e "  ${YELLOW}Options:${NC}"
    echo "    1. Abort and investigate:"
    echo "       git reset              # Unstage all changes"
    echo "       git status             # Verify untracked files"
    echo "       git log --oneline -5   # Check recent commits"
    echo ""
    echo "    2. Force commit if intentional:"
    echo "       git commit --no-verify"
    echo ""
    echo "    3. Partial unstaging (if some deletions are intentional):"
    echo "       git reset HEAD <files-to-keep>"
    echo ""
    echo -e "${CYAN}──────────────────────────────────────────────────────────────${NC}"
    echo ""

    exit 1
}

main "$@"
