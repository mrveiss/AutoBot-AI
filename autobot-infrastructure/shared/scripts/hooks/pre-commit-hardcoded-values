#!/bin/bash
# Copyright 2025-2026 mrveiss
# SPDX-License-Identifier: Apache-2.0
# AutoBot - AI-Powered Automation Platform
# Author: mrveiss
#
# Pre-commit Hook: Hardcoded Value Detection — STAGED FILES entry point.
#
# Issue: #694 (rules) / #14371 (consolidation)
#
# #14371: this is now a thin entry point. Every rule lives in
# scripts/lib/hardcoded-value-rules.sh, which carries the UNION of what the
# three former detectors implemented — this hook, the CI tree scanner, and the
# dormant autobot-infrastructure/shared/scripts/detect-hardcoded-values.sh
# whose rules had never run anywhere. pipeline-scripts/detect-hardcoded-values.sh
# is the other entry point onto the same rules.
#
# This one differs from the tree scanner in exactly two ways, and both are
# entry-point policy rather than rule content:
#   * it scans the staged file list (or an explicit argv list from CI);
#   * it exits 1 on a violation, because it is the one with the power to stop a
#     commit.
#
# Install: pre-commit install (registered in .pre-commit-config.yaml)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/_common.sh
source "$SCRIPT_DIR/lib/_common.sh" || {
    echo "FATAL: cannot load lib/_common.sh — refusing to report clean" >&2
    exit 1
}

# Named PROJECT_ROOT, not REPO_ROOT, and that spelling is load-bearing:
# repo_tests/shell_lib_sources_resolve_test.py (#14041/#14172) resolves a
# `source .../lib/...` path by expanding SCRIPT_DIR and PROJECT_ROOT, and skips
# any site still containing a `$` it cannot expand. Spelled REPO_ROOT, this
# hook's rule-library source was COLLECTED as a call site and then silently
# skipped by the resolution check — present in the guard's reach numbers,
# verified by nothing. Using the spelling the canonical guard already
# understands puts the site back under it.
#
# Resolved from THIS SCRIPT's location, not from `git rev-parse` against the
# cwd. The hook must load the rules and the baseline belonging to the checkout
# it is part of; resolving through the cwd makes it load whichever tree it
# happens to be pointed at — and in a throwaway repo (which is how its own test
# suite drives it) that is no tree at all, so the load fails and the hook cannot
# report anything.
PROJECT_ROOT="$(cd "${SCRIPT_DIR}/../../../.." && pwd)"
[ -f "${PROJECT_ROOT}/scripts/lib/hardcoded-value-rules.sh" ] || {
    echo "FATAL: rule library not found under ${PROJECT_ROOT} — refusing to report clean" >&2
    exit 1
}
# shellcheck source=scripts/lib/hardcoded-value-rules.sh
source "${PROJECT_ROOT}/scripts/lib/hardcoded-value-rules.sh" || {
    echo "FATAL: cannot load scripts/lib/hardcoded-value-rules.sh — refusing to report clean" >&2
    exit 1
}

# Staged files, with the #6785 positional-args override so the same script runs
# as a local pre-commit hook AND as a CI gate. hv_file_in_scope applies the
# extension and exclusion rules — the same ones the tree scanner uses, so the
# two entry points cannot disagree about what is in scope.
#
# GH#14151: get_staged_files' own git-diff failure (a corrupted index, say) is
# propagated rather than masked, so a broken git cannot read as "nothing
# staged".
get_files_to_scan() {
    local staged file
    staged="$(get_staged_files '.' "$@")" || return 1
    while IFS= read -r file; do
        [ -n "$file" ] && hv_file_in_scope "$file" && printf '%s\n' "$file"
    done <<< "$staged"
    return 0
}

main() {
    printf '%b\n' "${BOLD}Pre-commit: Hardcoded Value Detection${NC}"
    echo "Issue #694 / #14371 — ${#HV_RULES[@]} rule classes: ${HV_RULES[*]}"
    echo "================================================"
    echo

    hv_load_baseline "${PROJECT_ROOT}/pipeline-scripts/hardcoded_values_baseline.txt" || exit 1

    local files
    files=$(get_files_to_scan "$@")
    if [ -z "$files" ]; then
        printf '%b\n' "${GREEN}No in-scope files staged for commit.${NC}"
        exit 0
    fi

    local raw newfile file
    raw=$(mktemp); newfile=$(mktemp)
    trap 'rm -f "$raw" "$newfile"' EXIT
    while IFS= read -r file; do
        [ -n "$file" ] && hv_scan_file "$file"
    done <<< "$files" > "$raw"

    # Redirection, not a pipe: through a pipe hv_partition runs in a subshell
    # and its suppressed-count dies with it.
    hv_partition < "$raw" > "$newfile"

    echo "Scanned $(printf '%s\n' "$files" | grep -c . || true) staged file(s)."
    # Printed on every run, pass or fail. A backlog nobody is reminded of is
    # indistinguishable from no backlog.
    [ "$HV_SUPPRESSED" -gt 0 ] && echo "  $HV_SUPPRESSED pre-existing finding(s) baselined, tracked in $HV_BASELINE_ISSUE"
    echo

    local violations warnings
    violations=$(grep -c '^VIOLATION|' "$newfile" || true)
    warnings=$(grep -c '^WARNING|' "$newfile" || true)

    while IFS='|' read -r sev class file lineno value; do
        [ -n "$sev" ] || continue
        if [ "$sev" = "VIOLATION" ]; then
            printf '%b %s:%s\n' "${RED}VIOLATION${NC}" "$file" "$lineno"
        else
            printf '%b %s:%s\n' "${YELLOW}WARNING${NC}" "$file" "$lineno"
        fi
        echo "  Hardcoded ${class} value: ${value}"
    done < "$newfile"

    echo "================================================"
    if [ "$violations" -gt 0 ]; then
        printf '%b\n' "${RED}COMMIT BLOCKED: $violations violation(s) found${NC}"
        [ "$warnings" -gt 0 ] && printf '%b\n' "${YELLOW}Plus $warnings warning(s)${NC}"
        echo
        echo "Run 'pipeline-scripts/detect-hardcoded-values.sh --report' for the full picture."
        echo "Documentation: docs/developer/HARDCODING_PREVENTION.md"
        exit 1
    fi
    if [ "$warnings" -gt 0 ]; then
        printf '%b\n' "${YELLOW}$warnings warning(s) — commit allowed${NC}"
        exit 0
    fi
    printf '%b\n' "${GREEN}No new violations found!${NC}"
    exit 0
}

main "$@"
