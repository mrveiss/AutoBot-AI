#!/usr/bin/env bash
# AutoBot - AI-Powered Automation Platform
# Copyright (c) 2025 mrveiss
# Author: mrveiss
#
# Target Branch Guard (Issue #4113)
# ==================================
#
# Enforces branching discipline by preventing direct commits on protected branches.
#
# PROTECTED BRANCHES (commits forbidden):
#   - release: Release branch. Must be merged FROM main via PR.
#   - master: Alias for release (legacy).
#
# ALLOWED BRANCHES (commits permitted):
#   - main: Active development branch
#   - issue-*: Feature branches (must target main in PR)
#   - hotfix-*: Hotfix branches (may target main or release, must be reviewed)
#   - Any worktree branch matching the above patterns
#
# ENFORCEMENT:
#   If you attempt to commit directly on a protected branch (e.g., `git commit` on release),
#   this hook blocks it and prints helpful guidance.
#
# REASON:
#   Issue #4113: Commits went to release instead of main, reversing the
#   branching discipline. This hook prevents future reversals.
#
# Related issues: #4113 (branch discipline), #1689 (branch safety)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/_common.sh
source "$SCRIPT_DIR/lib/_common.sh" || {
    echo "FATAL: cannot load lib/_common.sh — refusing to report clean" >&2
    exit 1
}

CURRENT_BRANCH=$(git branch --show-current 2>/dev/null)

# If HEAD is detached, allow commit (no branch to guard)
if [ -z "$CURRENT_BRANCH" ]; then
    exit 0
fi

# Check if on a protected branch
case "$CURRENT_BRANCH" in
    release|master)
        # PROTECTED: Reject commit
        echo ""
        echo -e "${BOLD}${RED}COMMIT BLOCKED: Direct commits to '${CURRENT_BRANCH}' are forbidden (Issue #4113)${NC}"
        echo -e "${CYAN}─────────────────────────────────────────────────────────────${NC}"
        echo ""
        echo -e "  ${BOLD}Why:${NC}"
        echo "    • ${CURRENT_BRANCH} is a protected branch (release/stable code only)"
        echo "    • Issue #4113: Commits went to release instead of main"
        echo "    • All development must flow through main first"
        echo ""
        echo -e "  ${BOLD}Correct workflow:${NC}"
        echo "    1. Create a feature branch: git checkout -b issue-XXXX origin/main"
        echo "    2. Make changes and commit on your feature branch"
        echo "    3. Push to GitHub: git push -u origin issue-XXXX"
        echo "    4. Open a PR: issue-XXXX → main"
        echo "    5. Merge to main (through PR review)"
        echo "    6. Later, main is merged into ${CURRENT_BRANCH} (release cycle)"
        echo ""
        echo -e "  ${BOLD}If you're doing a hotfix:${NC}"
        echo "    git checkout -b hotfix-XXXX origin/main"
        echo "    # Make changes, commit, push, open PR"
        echo ""
        echo -e "  ${BOLD}Current branch:${NC} ${CURRENT_BRANCH}"
        echo -e "${CYAN}─────────────────────────────────────────────────────────────${NC}"
        echo ""
        exit 1
        ;;
    *)
        # ALLOWED: Permit commit on main, issue-*, hotfix-*, or other branches
        exit 0
        ;;
esac
