[Unit]
Description=AutoBot User Backend API
Documentation=https://github.com/mrveiss/AutoBot-AI
After=network.target redis-stack-server.service autobot-chromadb.service
Wants=redis-stack-server.service autobot-chromadb.service
# #20620, #4090: a restarting unit must be able to reach `failed`. The window has to exceed
# RestartSec * StartLimitBurst, or the limit is never hit and the unit loops forever while
# showing `activating`. Same values as the role-rendered units.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
User=autobot
Group=autobot
WorkingDirectory=/opt/autobot/autobot-user-backend
# #20894: the log directory, as before the resolver (the working directory's logs/)
Environment=AUTOBOT_LOGS_DIR=/opt/autobot/autobot-user-backend/logs
Environment="PATH=/opt/autobot/autobot-user-backend/venv/bin:/usr/local/bin:/usr/bin"
Environment="PYTHONPATH=/opt/autobot/autobot-user-backend"
EnvironmentFile=-/opt/autobot/autobot-user-backend/.env
EnvironmentFile=-/etc/autobot/service-keys/main-backend.env

# Issue #1240: Added --limit-max-requests to recycle workers and prevent memory leak
ExecStart=/opt/autobot/autobot-user-backend/venv/bin/uvicorn \
    main:app \
    --host 0.0.0.0 \
    --port 8001 \
    --workers 4 \
    --log-level info \
    --limit-max-requests 1000

ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5
# Issue #4309: Use LogsDirectory= for proper ownership instead of StandardOutput=append
LogsDirectory=autobot
StandardOutput=journal
StandardError=journal
SyslogIdentifier=autobot-user-backend
# Issue #1240: Memory limits to prevent runaway growth
MemoryHigh=12G
MemoryMax=16G
TimeoutStopSec=90

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/autobot/autobot-user-backend/data

[Install]
WantedBy=multi-user.target
