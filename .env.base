# AutoBot environment BASE -- the keys every environment file shares, written once (#18555).
# Load order: this file first, then ONE overlay (.env.localhost, .env.native-vm, .env.network or
# .env.network-template); the overlay overrides or adds keys. Docker uses docker/.env.docker instead.
# repo_tests/env_file_family_18555_test.py fails when an overlay repeats a key here with the same value.
# NOTE: host IPs are set at deploy time -- empty values here are filled per deployment.

AUTOBOT_BACKEND_HOST=
AUTOBOT_FRONTEND_HOST=
AUTOBOT_REDIS_HOST=
AUTOBOT_OLLAMA_HOST=
AUTOBOT_AI_STACK_HOST=
AUTOBOT_NPU_WORKER_HOST=
AUTOBOT_BROWSER_SERVICE_HOST=
AUTOBOT_BACKEND_PORT=8001
AUTOBOT_FRONTEND_PORT=5173
AUTOBOT_FRONTEND_SERVED_BY=vite
AUTOBOT_REDIS_PORT=6379
AUTOBOT_OLLAMA_PORT=11434
AUTOBOT_AI_STACK_PORT=8080
AUTOBOT_NPU_WORKER_PORT=8081
AUTOBOT_BROWSER_SERVICE_PORT=9001
AUTOBOT_VNC_PORT=6080
REDIS_HOST=
REDIS_PORT=6379
OLLAMA_HOST=
