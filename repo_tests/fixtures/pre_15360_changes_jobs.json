 "ai-security-review": {
  "base_is_merge_group": false,
  "checkout": true,
  "checkout_uses": "actions/checkout@v7",
  "consumed_outputs": [
   "reviewable"
  ],
  "declared_outputs_read_from_step": true,
  "display_name": "Detect changed paths",
  "dorny_uses": "dorny/paths-filter@ceb8a2b8f2d89434be7ff52d3de7ec3738c5cc9d",
  "filters": {
   "content": {
    "backend": [
     [
      "autobot-backend/**/*.py",
      "autobot-slm-backend/**/*.py",
      "autobot_shared/**/*.py",
      ".github/filters/backend-python-paths.yml"
     ],
     "**/requirements*.txt",
     "requirements-ci/**",
     ".github/workflows/startup-import-smoke.yml",
     ".github/workflows/backend-required-context.yml"
    ],
    "backend-python": [
     "autobot-backend/**/*.py",
     "autobot-slm-backend/**/*.py",
     "autobot_shared/**/*.py",
     ".github/filters/backend-python-paths.yml"
    ],
    "deps": [
     "**/requirements*.txt",
     "requirements-ci/**",
     "pyproject.toml",
     "autobot_shared/pyproject.toml",
     "autobot-frontend/package*.json",
     ".github/workflows/security.yml"
    ],
    "python": [
     [
      "autobot-backend/**/*.py",
      "autobot-slm-backend/**/*.py",
      "autobot_shared/**/*.py",
      ".github/filters/backend-python-paths.yml"
     ],
     ".github/workflows/security.yml"
    ],
    "reviewable": [
     [
      "autobot-backend/**/*.py",
      "autobot-slm-backend/**/*.py",
      "autobot_shared/**/*.py",
      ".github/filters/backend-python-paths.yml"
     ],
     "ansible/**",
     ".github/workflows/ai-security-review.yml"
    ],
    "wiring": [
     [
      "autobot-backend/**/*.py",
      "autobot-slm-backend/**/*.py",
      "autobot_shared/**/*.py",
      ".github/filters/backend-python-paths.yml"
     ],
     "autobot-frontend/src/**",
     "scripts/audit_api_wiring.py",
     "scripts/api_wiring_baseline.txt",
     "requirements*.txt",
     ".github/workflows/api-wiring.yml"
    ]
   },
   "file": ".github/filters/backend-python-paths.yml"
  },
  "job_level_extras": [],
  "on": {
   "pull_request": {
    "branches": [
     "release",
     "main"
    ],
    "paths": [
     "autobot-backend/**/*.py",
     "autobot-slm-backend/**/*.py",
     "autobot_shared/**/*.py",
     ".github/filters/backend-python-paths.yml",
     "ansible/**",
     ".github/workflows/ai-security-review.yml"
    ]
   }
  },
  "outputs": [
   "reviewable"
  ],
  "pr_only": false,
  "runs_on": "ubuntu-latest",
  "step_id": "filter",
  "timeout": 360
 },
