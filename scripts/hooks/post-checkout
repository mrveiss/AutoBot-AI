#!/bin/bash
# AutoBot - AI-Powered Automation Platform
# Copyright (c) 2025 mrveiss
# Author: mrveiss
#
# Post-checkout hook:
#   1. Fix WSL2 symlink breakage (Issue #886)
#   2. Fix pre-commit hook script permissions (Issue #1683)
#   3. Auto-install prepare-commit-msg hook type (Issue #1679)
#   4. Auto-install/sync pre-commit hook: branch-guard-only wrapper (Issue
#      #1689) on an old checkout, or tools/git-hooks/pre-commit's branch
#      guard + formatter dispatch (Issue #16923) when that template exists
#   5. Inject flock wrapper into pre-commit hook (Issue #1684)
#   6. Self-sync: keep .git/hooks/post-checkout in sync (Issue #1692)
#   7. Link node_modules into a linked worktree (Issue #16912)

# Skip file checkouts (e.g. stash pop) — only run on branch checkouts (#1705)
# $3 = 1 for branch checkout, 0 for file checkout
if [ "${3:-1}" = "0" ]; then
    exit 0
fi

# Determine git root directory
if [ -n "$GIT_DIR" ]; then
    GIT_ROOT="$(cd "$GIT_DIR/.." 2>/dev/null && pwd)" || exit 0
else
    GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
fi

# ---------------------------------------------------------------------------
# 1. Fix WSL2 symlinks (Issue #886)
# ---------------------------------------------------------------------------
BACKEND_DIR="$GIT_ROOT/autobot-backend"
BACKEND_SYMLINK="$BACKEND_DIR/backend"

if [ -d "$BACKEND_DIR" ] && { [ ! -L "$BACKEND_SYMLINK" ] || [ ! -e "$BACKEND_SYMLINK" ]; }; then
    if cd "$BACKEND_DIR" 2>/dev/null; then
        echo "🔧 Fixing backend symlink..."
        rm -f backend
        ln -s . backend
        echo "✅ Backend symlink restored: $BACKEND_SYMLINK -> ."
    fi
fi

# ---------------------------------------------------------------------------
# 7. Link node_modules into a linked worktree (Issue #16912)
# ---------------------------------------------------------------------------
# A worktree has no node_modules of its own, and the main checkout's copy is
# not an ancestor directory, so Node cannot resolve it: vitest and vue-tsc
# could not run AT ALL for a frontend change made in a worktree, and pre-push
# degraded to a warning and pushed anyway. Frontend PRs therefore arrived with
# strictly less local evidence than backend ones -- a test that has never run
# against the unfixed code is not yet a negative control.
#
# Installing here is not the fix: the repository prohibits installing into the
# codebase, and a per-worktree install would also cost ~800MB each. Linking to
# the main checkout's existing install gives every worktree the same store,
# installs nothing, and needs no new tooling -- the same shape as the backend
# symlink in section 1.
#
# Only in a LINKED worktree, only when the main checkout actually has the
# directory, and never over something already present: a real install in this
# tree always wins. A dangling link from an earlier run is replaced, not
# reused, because a broken link resolves as "no node_modules" anyway.
COMMON_DIR="$(git rev-parse --git-common-dir 2>/dev/null)"
case "$COMMON_DIR" in
    "")  MAIN_ROOT="" ;;
    /*)  MAIN_ROOT="$(cd "$COMMON_DIR/.." 2>/dev/null && pwd)" ;;
    *)   MAIN_ROOT="$(cd "$GIT_ROOT/$COMMON_DIR/.." 2>/dev/null && pwd)" ;;
esac

if [ -n "$MAIN_ROOT" ] && [ "$MAIN_ROOT" != "$GIT_ROOT" ]; then
    for _proj in autobot-frontend autobot-slm-frontend; do
        _src="$MAIN_ROOT/$_proj/node_modules"
        _dst="$GIT_ROOT/$_proj/node_modules"
        [ -d "$GIT_ROOT/$_proj" ] || continue
        [ -d "$_src" ] || continue
        if [ -L "$_dst" ] && [ ! -e "$_dst" ]; then
            rm -f "$_dst"
        fi
        if [ ! -e "$_dst" ]; then
            ln -s "$_src" "$_dst" \
                && echo "🔗 Linked $_proj/node_modules -> the main checkout's install (#16912)"
        fi
    done
fi

# ---------------------------------------------------------------------------
# 2. Fix hook script permissions (Issue #1683)
# ---------------------------------------------------------------------------
HOOK_SCRIPTS_DIR="$GIT_ROOT/autobot-infrastructure/shared/scripts"
FIXED=0
# A filename never justified the executable bit; a shebang does (#15253). The
# name patterns below only nominate candidates — each one still has to declare
# itself executable before it is chmod'ed. Without that gate "pre-commit-*" also
# matched the pre-commit-*_test.py pytest files, and "*.sh" also matched
# hooks/lib/_common.sh, which is sourced rather than run. Neither carries a
# shebang, neither is tracked as executable, and chmod'ing them left every
# working tree in the repository permanently dirty with mode-only changes.
if [ -d "$HOOK_SCRIPTS_DIR" ]; then
    while IFS= read -r -d '' f; do
        # Reset first: read returns non-zero at EOF but still assigns, so a
        # one-line file with no trailing newline must keep what it read, while
        # an unreadable file must not inherit the previous iteration's value.
        firstline=""
        IFS= read -r firstline < "$f" 2>/dev/null || true
        case "$firstline" in
            '#!'*) ;;
            *) continue ;;
        esac
        chmod +x "$f"
        FIXED=$((FIXED + 1))
    done < <(find "$HOOK_SCRIPTS_DIR/hooks" "$HOOK_SCRIPTS_DIR/utilities" \
                  -type f \( -name "pre-commit-*" -o -name "post-commit-*" \
                             -o -name "inject-*" -o -name "slm-*" \
                             -o -name "*.sh" \) \
                  -not -perm -u+x -print0 2>/dev/null)
    if [ "$FIXED" -gt 0 ]; then
        echo "✅ Fixed permissions on $FIXED hook script(s)"
    fi
fi

# ---------------------------------------------------------------------------
# 3. Auto-install prepare-commit-msg hook if missing (Issue #1679)
# ---------------------------------------------------------------------------
HOOKS_DIR="$(git rev-parse --git-dir 2>/dev/null)/hooks"
if [ -d "$HOOKS_DIR" ] && [ ! -f "$HOOKS_DIR/prepare-commit-msg" ]; then
    if command -v pre-commit > /dev/null 2>&1; then
        pre-commit install --hook-type prepare-commit-msg > /dev/null 2>&1 || true
    fi
fi

# ---------------------------------------------------------------------------
# 4. Auto-install/sync pre-commit hook (Issue #2512, #1689, #2519, #16923)
# ---------------------------------------------------------------------------
# Replaces pre-commit's default hook with a wrapper that calls
# `pre-commit run --files` (bypassing the stash cycle). Also retains
# a branch guard as a safety net.
#
# Layout:
#   .git/hooks/pre-commit                      → stash-free wrapper, or the
#                                                 #16923 branch-guard+formatter
#                                                 template once that exists
#   .git/hooks/pre-commit.pre-commit-framework → original pre-commit hook,
#                                                 backed up when wrapped (above)
#   .git/hooks/pre-commit.pre-formatter-dispatch → whatever pre-commit hook
#                                                 (old wrapper, or hand-
#                                                 customized) was replaced by
#                                                 the #16923 template (below)
#
# Superseded, when present in THIS checkout, by tools/git-hooks/pre-commit
# (#16923): the same branch guard, chained into formatter dispatch, and
# installed separately by scripts/install-git-hooks.sh (#11598) -- the
# authoritative source for that file. "Is the installed hook already this
# newer template" is answered below by diffing the installed hook against
# tools/git-hooks/pre-commit's OWN tracked content, never by grepping the
# installed hook for a marker string: a string check is exactly what broke
# this (found in review on PR #16938, before #16923 merged). The old
# `grep -q "Issue #1689"` below existed only to identify the WRAPPER; the
# #16923 hook is neither the wrapper nor a raw `pre-commit install`-generated
# hook, so it satisfied the "does not contain the marker" branch too and got
# silently swapped for the wrapper on the very next checkout, discarding the
# formatter dispatch this hook exists to run -- AC2 ("the Target Branch Guard
# must not be traded away for the formatter") held only inside #16923's own
# test fixture, which has no post-checkout hook present, never in a real
# checkout with both hooks installed. Content-diffing against the real
# tracked template instead means any future edit to tools/git-hooks/pre-commit
# -- wording, sections, anything -- is picked up automatically here with
# nothing to keep in sync.
WRAPPER_SRC="$GIT_ROOT/scripts/hooks/pre-commit-branch-guard-wrapper"
NEW_PRECOMMIT_SRC="$GIT_ROOT/tools/git-hooks/pre-commit"

if [ -d "$HOOKS_DIR" ] && [ -f "$NEW_PRECOMMIT_SRC" ]; then
    # tools/git-hooks/pre-commit exists in this checkout, so it -- not the
    # older wrapper -- is what .git/hooks/pre-commit is kept in sync with.
    # Self-synced the same way section 6 below keeps post-checkout itself
    # current: copy over whenever the two differ (mod the flock block
    # injected separately in step 5), so a fresh clone, a genuinely stale
    # hook, AND a stale copy of an older tools/git-hooks/pre-commit all
    # converge on the current template through the one comparison -- a
    # truly outdated/foreign hook still gets replaced, it is just replaced
    # with the modern branch-guard-plus-formatter-dispatch template instead
    # of the older branch-guard-only wrapper.
    PRECOMMIT_HOOK="$HOOKS_DIR/pre-commit"
    # Backup for whatever this branch supersedes -- named for what it
    # supersedes (the pre-#16923 state), same pattern the wrapper-swap
    # branch below uses for what IT supersedes
    # (pre-commit -> pre-commit.pre-commit-framework).
    BACKUP_HOOK="$HOOKS_DIR/pre-commit.pre-formatter-dispatch"

    # Never clobber a hook `pre-commit install` generated itself (parity
    # with scripts/install-git-hooks.sh's own exception, #11598): that hook
    # already runs the full quality suite AND the target-branch-guard local
    # hook from .pre-commit-config.yaml -- a superset of this template.
    if [ ! -f "$PRECOMMIT_HOOK" ] || ! grep -q "generated by pre-commit" "$PRECOMMIT_HOOK" 2>/dev/null; then
        _installed_precommit=""
        if [ -f "$PRECOMMIT_HOOK" ]; then
            _installed_precommit=$(sed '/^# --- AUTOBOT_FLOCK/,/^# --- END AUTOBOT_FLOCK/d' "$PRECOMMIT_HOOK")
        fi
        if [ "$_installed_precommit" != "$(cat "$NEW_PRECOMMIT_SRC")" ]; then
            # Whatever is installed here is neither this template
            # (byte-identical, just ruled out above) nor a real
            # pre-commit-framework-generated hook (ruled out by the
            # containing `if`) -- it is either the OLD branch-guard-only
            # wrapper (#1689) on a first-time #16923 upgrade, or a
            # developer's hand-customized hook. Either way it must not be
            # silently destroyed (found in review on PR #16938): move it
            # aside before the template replaces it.
            if [ -f "$PRECOMMIT_HOOK" ]; then
                mv "$PRECOMMIT_HOOK" "$BACKUP_HOOK"
            fi
            cp "$NEW_PRECOMMIT_SRC" "$PRECOMMIT_HOOK"
            chmod +x "$PRECOMMIT_HOOK"
        fi
    fi
elif [ -d "$HOOKS_DIR" ] && [ -f "$WRAPPER_SRC" ]; then
    # tools/git-hooks/pre-commit does not exist in this checkout (a branch
    # or tag from before #16923) -- fall back to the original wrapper-based
    # install/update behaviour unchanged.
    PRECOMMIT_HOOK="$HOOKS_DIR/pre-commit"
    FRAMEWORK_HOOK="$HOOKS_DIR/pre-commit.pre-commit-framework"

    # Install wrapper if no hook exists yet (fresh clone)
    if [ ! -f "$PRECOMMIT_HOOK" ] && [ ! -f "$FRAMEWORK_HOOK" ]; then
        if command -v pre-commit > /dev/null 2>&1; then
            pre-commit install > /dev/null 2>&1 || true
            if [ -f "$PRECOMMIT_HOOK" ]; then
                mv "$PRECOMMIT_HOOK" "$FRAMEWORK_HOOK"
                cp "$WRAPPER_SRC" "$PRECOMMIT_HOOK"
                chmod +x "$PRECOMMIT_HOOK" "$FRAMEWORK_HOOK"
            fi
        fi
    # Wrap if current hook is the raw pre-commit framework (no wrapper)
    elif [ -f "$PRECOMMIT_HOOK" ] && ! grep -q "Issue #1689" "$PRECOMMIT_HOOK" 2>/dev/null; then
        mv "$PRECOMMIT_HOOK" "$FRAMEWORK_HOOK"
        cp "$WRAPPER_SRC" "$PRECOMMIT_HOOK"
        chmod +x "$PRECOMMIT_HOOK" "$FRAMEWORK_HOOK"
    # Update stale wrapper if source template has changed (#2519)
    elif [ -f "$PRECOMMIT_HOOK" ] && grep -q "Issue #1689" "$PRECOMMIT_HOOK" 2>/dev/null; then
        # Strip flock block before comparing (flock is injected separately)
        _installed=$(sed '/^# --- AUTOBOT_FLOCK/,/^# --- END AUTOBOT_FLOCK/d' "$PRECOMMIT_HOOK")
        _source=$(cat "$WRAPPER_SRC")
        if [ "$_installed" != "$_source" ]; then
            cp "$WRAPPER_SRC" "$PRECOMMIT_HOOK"
            chmod +x "$PRECOMMIT_HOOK"
        fi
    fi
fi

# ---------------------------------------------------------------------------
# 5. Inject flock wrapper into pre-commit hook (Issue #1684)
# ---------------------------------------------------------------------------
# Git worktrees share .git/refs/stash. When multiple worktrees run
# pre-commit hooks in parallel, the stash push/pop operations collide
# and commits leak across branches. This injects an exclusive flock
# that serializes pre-commit across all worktrees.
#
# The lock file lives in git-common-dir (shared across worktrees).
# The fd (200) is inherited by the exec'd pre-commit process and
# auto-released when pre-commit exits.
INJECT_SCRIPT="$GIT_ROOT/autobot-infrastructure/shared/scripts/hooks/inject-flock-wrapper"
if [ -x "$INJECT_SCRIPT" ]; then
    "$INJECT_SCRIPT"
elif [ -f "$INJECT_SCRIPT" ]; then
    bash "$INJECT_SCRIPT"
fi

# ---------------------------------------------------------------------------
# 6. Self-sync: keep .git/hooks/post-checkout in sync (Issue #1692)
# ---------------------------------------------------------------------------
# The canonical post-checkout hook lives in the tracked tree at
# scripts/hooks/post-checkout. This section copies it into .git/hooks/
# whenever the installed version differs, so developers always run the
# latest version after checkout — even in worktrees.
CANONICAL="$GIT_ROOT/scripts/hooks/post-checkout"
COMMON_HOOKS="$(git rev-parse --git-common-dir 2>/dev/null)/hooks"
INSTALLED="${COMMON_HOOKS}/post-checkout"
if [ -f "$CANONICAL" ] && [ -d "$COMMON_HOOKS" ]; then
    if [ ! -f "$INSTALLED" ] || ! diff -q "$CANONICAL" "$INSTALLED" > /dev/null 2>&1; then
        # #15532: never cp over the path this script is executing from. bash reads
        # a script incrementally and remembers a byte offset; rewriting the live
        # file in place makes the running shell resume at that offset inside
        # different content. A same-directory temp file plus an atomic rename
        # leaves this process on its original inode and every later invocation on
        # the new one. chmod before the rename, so the installed hook is never
        # present-but-not-executable. The temp name is fixed, so an interrupted
        # run leaves at most one stale file that the next run overwrites; the
        # unconditional rm clears it when any step above failed (a no-op when the
        # rename succeeded). Git only ever executes the exact hook name, so
        # "post-checkout.new" is never mistaken for a hook.
        INSTALLED_TMP="${INSTALLED}.new"
        cp "$CANONICAL" "$INSTALLED_TMP" \
            && chmod +x "$INSTALLED_TMP" \
            && mv -f "$INSTALLED_TMP" "$INSTALLED"
        rm -f "$INSTALLED_TMP"
    fi
fi

exit 0
