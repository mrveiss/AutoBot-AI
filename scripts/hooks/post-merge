#!/bin/bash
# AutoBot - AI-Powered Automation Platform
# Copyright (c) 2025-2026 mrveiss
# Author: mrveiss
#
# Post-merge hook:
#   1. Chain to doc-sync post-merge hook (Issue #250, #16934)
#
# #16934: doc-sync moved here from post-commit. post-commit fired on every
# commit in every worktree and indexed that worktree's own tree into the
# shared, live autobot_docs collection -- post-merge fires only after a
# local `git merge`/`git pull`, so a fresh worktree's first commit (a plain
# `git commit`) no longer reaches this at all. The chained script itself
# further gates on the merge actually landing origin/main's own tip.

GIT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"

DOC_SYNC="$GIT_ROOT/autobot-infrastructure/shared/scripts/hooks/post-merge-doc-sync"
if [ -x "$DOC_SYNC" ]; then
    "$DOC_SYNC"
elif [ -f "$DOC_SYNC" ]; then
    bash "$DOC_SYNC"
fi

# ---------------------------------------------------------------------------
# #17578: keep the installed pre-push in step with its tracked copy.
#
# Hooks are COPIED, not symlinked (#11598), and nothing synced this one. The
# measured cost on a live checkout: .git/hooks/pre-push was the tracked file as
# of 4bae334f12 -- two revisions behind, without #16912's two `could_not_run`
# branches and without #17035's `REPO_ROOT="$PWD"`. The second is the one that
# matters: the old spelling goes through `git rev-parse --show-toplevel`, which
# an inherited GIT_DIR outranks, so the running hook could verify a DIFFERENT
# checkout than the one being pushed. Every "hooks green" claim made while that
# was installed described a gate nobody could name.
#
# `pre-push` ONLY, deliberately. `pre-commit` is already kept in step above, by
# a comparison that strips the separately-injected flock block -- pointing a
# second mechanism at the same file is how two managers of one thing drift, and
# it would re-copy the template on every checkout, stripping a flock that the
# later step then re-injects.
#
# The installer is reused rather than a third content-diff written here: it
# skips a pre-commit-framework-generated hook, replaces a symlink with a real
# file, short-circuits on `cmp -s`, and backs up an UNMANAGED hook instead of
# destroying a developer's own. It also unsets GIT_DIR up front (#15246) --
# the same trap #17035 fixed one file over.
#
# Not the atomic-rename dance the self-sync below needs: `pre-push` is not the
# script executing here, so a plain copy cannot make a running shell resume at
# a byte offset inside new content (#15532). Anyone extending this to a hook
# that IS running must use that idiom instead -- see
# repo_tests/hook_self_sync_atomic_test.py.
# The probe is load-bearing, not defensive politeness. `.git/hooks` is ONE
# directory shared by every worktree; this installer is per worktree. So a hook
# installed from a tree that has the --sync mode will be invoked from trees that
# do not, and an installer without it ignored the unknown argument and ran a
# FULL install -- normalise_hooks_path included. That happened on this machine
# before the guard existed. A tree without the mode now simply does not sync,
# which is correct and silent.
INSTALLER="$GIT_ROOT/scripts/install-git-hooks.sh"
if [ -f "$INSTALLER" ] && grep -q 'SYNC_ONLY=' "$INSTALLER"; then
    # Provenance (#17578, 63's ask): say which pre-push is in place, so nobody
    # has to ask afterwards which hook ran. `git hash-object` is the same
    # identity git itself uses, so the two sides are directly comparable, and
    # the tracked side is named rather than assumed.
    _tracked_hook="$GIT_ROOT/tools/git-hooks/pre-push"
    _installed_hook="$(git rev-parse --git-common-dir 2>/dev/null)/hooks/pre-push"
    _before="$(git hash-object "$_installed_hook" 2>/dev/null | cut -c1-10)"
    bash "$INSTALLER" --sync pre-push || true
    _after="$(git hash-object "$_installed_hook" 2>/dev/null | cut -c1-10)"
    _want="$(git hash-object "$_tracked_hook" 2>/dev/null | cut -c1-10)"
    if [ -n "$_after" ] && [ "$_before" != "$_after" ]; then
        echo "   pre-push now ${_after} (tracked ${_want}); was ${_before:-absent}" >&2
    fi
fi

exit 0
